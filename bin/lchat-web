_PKG_LABELS = ("search", "info", "install", "update", "remove", "which package owns a file", "files of a package",
               "is it installed")


def _native_pm():
    if MACOS:
        return "brew" if _find("brew") else None
    ids = []
    try:
        osr = dict(l.strip().split("=", 1) for l in open("/etc/os-release", encoding="utf-8") if "=" in l)
        ids = [osr.get("ID", "").strip('"')] + osr.get("ID_LIKE", "").strip('"').split()
    except OSError:
        pass
    return next((pm for fam in ids for f, pm in _PKG_BY_FAMILY if fam == f and _find(pm)), None)


def pkg_guide():
    """How to install / update / remove software and get help on THIS machine, for the agent prompt. Only the
    managers that are installed are listed; the native one first."""
    native = _native_pm()
    have = [pm for pm in _PKG_CMDS if _find(pm)]
    order = ([native] if native in have else []) + [pm for pm in have if pm != native]
    lines = ["Packages on this system. Use ONLY these managers (never apt on Arch, never pacman on Debian, and so on)."]
    for pm in order:
        cmds = "; ".join(f"{lab}: {c}" for lab, c in zip(_PKG_LABELS, _PKG_CMDS[pm]) if c)
        lines.append(f"- {pm}{' (native)' if pm == native else ''}: {cmds}")
    ro = _shutil.which("steamos-readonly") and "enabled" in _cmd(["steamos-readonly", "status"], timeout=5)
    rules = [
        "To install: search first, show the exact package name and which manager you will use, then install.",
        "Install, update and remove change the system: show the command and run it only after the user agrees "
        "(the bash tool asks for approval); system managers need sudo.",
        "Remove with the same manager that installed it (check: " + ", ".join(
            c for c in (_PKG_CMDS[pm][7] for pm in order) if c)[:200] + ").",
        "Desktop apps: prefer flatpak (Flathub) when it is installed; command-line tools: the native manager"
        + "".join(f"; {k}: {v}" for k, v in (("Python tools", " or ".join(m for m in ("pipx", "uv") if m in have)),
                                                ("Rust tools", "cargo" if "cargo" in have else ""),
                                                ("JavaScript tools", "npm -g" if "npm" in have else "")) if v) + ".",
    ]
    if ro:
        rules.append("SteamOS: the root filesystem is read-only and pacman installs are lost on the next OS update. "
                     "Use flatpak for apps, distrobox or pipx/pip --user/~/.local for tools; only use "
                     "`sudo steamos-readonly disable` + pacman if the user explicitly wants that.")
    if _find("distrobox"):
        rules.append("distrobox: a container with another distro's package manager (distrobox create -i <image> "
                     "-n <name>; distrobox enter <name>; inside, use that distro's commands).")
    lines += ["Rules:"] + [f"- {r}" for r in rules]
    lines.append("Help for a command or app: 1) is it installed (command -v <cmd>; " +
                 ("flatpak list --app | grep -i <name>; " if "flatpak" in have else "") +
                 "the native 'is it installed' command); 2) <cmd> --help, man <cmd>" +
                 (", tldr <cmd>" if _find("tldr") else "") + ", info <cmd>, /usr/share/doc/<pkg>; 3) the linux_help "
                 "tool (verified step-by-step cards); 4) web_search for the official documentation. For a package: "
                 "its info command above shows the description, version, homepage and dependencies.")
    return "\n".join(lines)


PKG_GUIDE = pkg_guide()


# ---------------- live machine state ----------------
def _mem_state():
    """(available fraction or None, pressure note or '')"""
    if MACOS:
        lvl = _cmd(["sysctl", "-n", "kern.memorystatus_level"])   # % of memory free, as the kernel rates it
        return (int(lvl) / 100 if lvl.isdigit() else None), ""
    mi = {}
    for l in _read("/proc/meminfo").splitlines():
        k, _, v = l.partition(":")
        if v.split():
            mi[k] = int(v.split()[0])
    psi = re.search(r"some avg10=([\d.]+)", _read("/proc/pressure/memory"))
    avail = mi.get("MemAvailable", 0) / mi["MemTotal"] if mi.get("MemTotal") else None
    return avail, (f"memory pressure {float(psi.group(1)):.0f}% (last 10 s)" if psi and float(psi.group(1)) >= 10 else "")


def _battery():
    """(percent, discharging) or None"""
    if MACOS:
        m = re.search(r"(\d+)%;\s*(\w+)", _cmd(["pmset", "-g", "batt"]))
        return (int(m.group(1)), m.group(2).lower() == "discharging") if m else None
    for b in sorted(_glob.glob("/sys/class/power_supply/BAT*")):
        cap = _read(b + "/capacity")
        if cap.isdigit():
            return int(cap), _read(b + "/status").lower() == "discharging"
    return None


def _pct(du):
    return du.used / ((du.used + du.free) or 1)   # as df computes Use% (reserved blocks excluded)


def _disks():
    seen, out = set(), []
    for p in ("/", os.path.expanduser("~")) + (("/System/Volumes/Data",) if MACOS else ()):
        try:
            st = os.stat(p)
            if st.st_dev in seen:
                continue
            seen.add(st.st_dev)
            out.append((p, _shutil.disk_usage(p)))
        except OSError:
            pass
    return out


_ALERTS = [0.0, ""]


def sys_alerts():
    """One short line of warnings about the machine's current state, '' when everything looks normal.
    Cheap (no subprocess on Linux), cached 10 s; the page adds it to every turn's system prompt."""
    if time.time() - _ALERTS[0] < 10:
        return _ALERTS[1]
    warn = []
    for p, du in _disks():
        free = du.free / 2**30
        if _pct(du) >= 0.9 or free < 1:
            warn.append(f"disk {p} {_pct(du):.0%} used, {free:.1f} GiB free")
    avail, psi = _mem_state()
    if avail is not None and avail < 0.1:
        warn.append(f"low memory: {avail:.0%} available")
    if psi:
        warn.append(psi)
    try:
        l1 = os.getloadavg()[0]
        if l1 > 1.5 * (os.cpu_count() or 1):
            warn.append(f"high CPU load {l1:.1f} on {os.cpu_count()} CPUs")
    except OSError:
        pass
    b = _battery()
    if b and b[1] and b[0] <= 15:
        warn.append(f"battery {b[0]}% and discharging")
    _ALERTS[:] = [time.time(), "; ".join(warn)]
    return _ALERTS[1]


_MAC_RE = re.compile(r"\b[0-9a-f]{2}(?::[0-9a-f]{2}){5}\b", re.I)


def _sh(cmd, timeout=8):
    """a fixed probe pipeline through bash (never model input); tools outside PATH are found via _EXTRA_PATH."""
    env = dict(os.environ, PATH=os.environ.get("PATH", "") + ":" + _EXTRA_PATH)
    try:
        r = subprocess.run(["bash", "-c", cmd], capture_output=True, text=True, errors="replace", timeout=timeout,
                           stdin=subprocess.DEVNULL, env=env)
        return (r.stdout + r.stderr).strip()
    except subprocess.TimeoutExpired:
        return "(timed out)"


_EXTRA_PATH = ":".join(dict.fromkeys(os.path.dirname(p) for n in _CONTAINERS + _K8S + _VPN_TOOLS + ("brew",)
                                     for p in [_find(n)] if p))

