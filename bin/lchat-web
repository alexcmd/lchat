import platform as _platform, shutil as _shutil

# native package manager per os-release family (ID, then ID_LIKE)
_PKG_BY_FAMILY = [("arch", "pacman"), ("debian", "apt"), ("ubuntu", "apt"), ("fedora", "dnf"), ("rhel", "dnf"),
                  ("suse", "zypper"), ("opensuse", "zypper"), ("alpine", "apk"), ("gentoo", "emerge"),
                  ("void", "xbps-install"), ("nixos", "nix")]


def system_info():
    """One paragraph about this machine for the agent prompt: OS/distro, kernel, desktop, package managers,
    read-only rootfs, CPU/RAM. Detected once at start-up; every probe is optional."""
    osr = {}
    try:
        for line in open("/etc/os-release", encoding="utf-8"):
            k, _, v = line.strip().partition("=")
            osr[k] = v.strip('"')
    except OSError:
        pass
    ids = [osr.get("ID", "")] + osr.get("ID_LIKE", "").split()
    native = next((pm for fam in ids for f, pm in _PKG_BY_FAMILY if fam == f and _shutil.which(pm)), None)
    present = [pm for pm in ("pacman", "apt", "dnf", "zypper", "apk", "emerge", "xbps-install", "nix", "flatpak",
                             "snap", "brew", "paru", "yay", "pip", "pipx", "distrobox") if _shutil.which(pm)]
    name = osr.get("PRETTY_NAME") or osr.get("NAME") or _platform.system()
    ver = osr.get("VERSION_ID", "")
    fam = ", ".join(x for x in ids[1:] if x) or ids[0] or "unknown"
    parts = [f"OS: {name}{' ' + ver if ver and ver not in name else ''} (id {ids[0] or '?'}, family {fam})"
             + (f", variant {osr['VARIANT_ID']}" if osr.get("VARIANT_ID") else ""),
             f"kernel {_platform.release()} {_platform.machine()}"]
    de, st = os.environ.get("XDG_CURRENT_DESKTOP", ""), os.environ.get("XDG_SESSION_TYPE", "")
    if de or st:
        parts.append(f"desktop {de or '?'} on {st or '?'}")
    pk = f"native package manager: {native}" if native else "native package manager: unknown"
    if present:
        pk += f" (installed: {', '.join(present)})"
    parts.append(pk)
    if _shutil.which("steamos-readonly"):
        try:
            ro = subprocess.run(["steamos-readonly", "status"], capture_output=True, text=True, timeout=5).stdout.strip()
        except Exception:
            ro = ""
        if ro:
            parts.append(f"SteamOS read-only root filesystem: {ro} - system packages installed with pacman are wiped "
                         "by OS updates; prefer flatpak (apps), distrobox, pip --user or ~/.local for tools, and "
                         "only use `sudo steamos-readonly disable` + pacman when the user agrees")
    try:
        mem = next(int(l.split()[1]) for l in open("/proc/meminfo") if l.startswith("MemTotal")) // 1024
        cpu = next((l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name")), "")
        parts.append(f"{os.cpu_count()} CPUs{' (' + cpu + ')' if cpu else ''}, {mem / 1024:.0f} GiB RAM")
    except Exception:
        pass
    parts.append(f"shell {os.path.basename(os.environ.get('SHELL', 'bash'))} (the bash tool runs bash), "
                 f"user {os.environ.get('USER', '?')}, sudo {'available' if _shutil.which('sudo') else 'missing'}")
    return "; ".join(parts) + "."


SYSTEM_INFO = system_info()


def tool_schemas():
    return [{"name": n, "approval": ap_,
             "schema": {"type": "function", "function": {"name": n, "description": d, "parameters": p}}}
            for n, (d, p, ap_) in TOOLS.items()]


class Cancelled(Exception):
    pass


def session(sid):
    with SESSIONS_LOCK:
        return SESSIONS.setdefault(str(sid or "default")[:64], {"cwd": DEFAULT_CWD})


def _wait(p, timeout, alive):
    """Wait for p; kill its whole process group on timeout or client disconnect."""
    end = time.time() + timeout
    while True:
        try:
            return p.wait(timeout=0.25)
        except subprocess.TimeoutExpired:
            pass
        reason = "timeout" if time.time() > end else ("cancelled" if not alive() else None)
        if reason:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                p.wait(timeout=5)
            except subprocess.TimeoutExpired:
                pass
            if reason == "cancelled":
                raise Cancelled()
            return None


def _read_capture(f):
    size = os.fstat(f.fileno()).st_size
    f.seek(0)
    if size <= MAX_CAPTURE:
        data = f.read()
    else:
        half = MAX_CAPTURE // 2
        data = f.read(half) + f"\n…[{size - MAX_CAPTURE} bytes skipped]…\n".encode()
        f.seek(size - half)
        data += f.read()
    return data.decode("utf-8", "replace")


# ---------------- tool implementations ----------------
def t_bash(command, timeout=60, *, sess, alive):
    timeout = max(1, min(int(timeout or 60), 600))
    marker = "__LCHAT_CWD__" + secrets.token_hex(4)
    cwd = sess["cwd"] if os.path.isdir(sess["cwd"]) else DEFAULT_CWD
    # cwd is passed to Popen (never interpolated into the script). Output goes to a
    # temp file, so background children holding stdout cannot block us.
    script = f'{command}\n__rc=$?\nprintf "\\n{marker}%s" "$PWD"\nexit $__rc\n'
    with tempfile.TemporaryFile() as out:
        p = subprocess.Popen(["bash", "-c", script], cwd=cwd, stdout=out, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, start_new_session=True)
        rc = _wait(p, timeout, alive)
        if rc is None:
            rc = f"timeout after {timeout}s (process group killed)"
        text = _read_capture(out)
    if marker in text:
        text, newcwd = text.rsplit(marker, 1)
        if os.path.isdir(newcwd):
            sess["cwd"] = newcwd
    text = text.rstrip("\n")
    return {"text": f"{clip(text) if text else '(no output)'}\n[exit {rc}] [cwd {sess['cwd']}]"}


def _path(p, sess):
    p = os.path.expanduser(p)
    return p if os.path.isabs(p) else os.path.join(sess["cwd"], p)


def t_read_file(path, offset=1, limit=400, *, sess, alive):
    p = _path(path, sess)
    st = os.stat(p)
    if not stat.S_ISREG(st.st_mode):
        raise ValueError(f"{p} is not a regular file")
    offset, limit = max(1, int(offset or 1)), max(1, min(int(limit or 400), 2000))
    sel, n, scanned = [], 0, 0
    with open(p, "rb") as f:
        for raw in f:
            n += 1
            scanned += len(raw)
            if offset <= n < offset + limit:
                sel.append(raw.decode("utf-8", "replace"))
            if scanned > MAX_READ and n >= offset + limit:
                break
    if b"\0" in "".join(sel[:50]).encode():
        return {"text": f"{p} looks binary ({st.st_size} bytes); use bash (file, xxd, strings) instead"}
    body = "".join(f"{i:5}  {l}" for i, l in enumerate(sel, offset))
    total = f"{n}" if scanned <= MAX_READ else f"{n}+ (stopped scanning at {MAX_READ // 1048576} MB)"
    return {"text": clip(body) + f"\n[lines {offset}-{offset + len(sel) - 1} of {total}]"}


def t_write_file(path, content, *, sess, alive):
    p = _path(path, sess)
    os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
    with open(p, "w") as f:
        f.write(content)
    return {"text": f"wrote {len(content)} chars to {p}"}


CRAWLER_LOCK = threading.Lock()   # one stealth browser at a time: the CloakBrowser binary allows a single
                                  # concurrent session, and a second one fails (Playwright wait_for_url timeout)


def _close_group(p):
    """Close the crawler after use: kill its whole process group (the browser and its helpers), even after a
    normal exit, so no Chromium is left running between tool calls."""
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass


def _crawler(args, timeout, alive):
    with CRAWLER_LOCK, tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        if not alive():
            raise Cancelled()
        p = subprocess.Popen(["python3", WEBCRAWLER] + args, stdout=out, stderr=err,
                             stdin=subprocess.DEVNULL, start_new_session=True,
                             env={**os.environ, "CLOAKBROWSER_SUPPRESS_FONT_WARNING": "1",
                                  "CLOAKBROWSER_AUTO_UPDATE": "false"})
        try:
            rc = _wait(p, timeout, alive)
        finally:
            _close_group(p)
        o, e = _read_capture(out), _read_capture(err)
    if rc is None:
        e += f"\ntimed out after {timeout}s"
    return rc, o, e


NOISE = re.compile(r"Update available|pip install --upgrade|font|^\s*$", re.I)


def _crawl_error(what, rc, e):
    lines = [l for l in e.strip().splitlines() if not NOISE.search(l)]
    if rc is None:
        return f"{what} timed out"
    if lines:
        return f"{what} failed (exit {rc}): " + " | ".join(lines[-3:])[-600:]
    return f"{what} failed (exit {rc}, no error output)"


def t_web_search(queries=None, num=10, query=None, images=False, *, sess, alive):
    if isinstance(queries, str):
        queries = [queries]
    qs = [q.strip() for q in (queries or []) + ([query] if query else []) if isinstance(q, str) and q.strip()]
    qs = list(dict.fromkeys(qs))[:5]
    if not qs:
        raise ValueError("give at least one query in `queries`")
    num = max(1, min(int(num or 10), 30))
    # One browser at a time (see CRAWLER_LOCK): the queries run one after another, each browser closed after
    # use, and a failed query is retried once.
    found, errors, pics = {}, {}, []
    for q in qs:
        for attempt in (1, 2):
            rc, o, e = _crawler(["search", "--num", str(num)] + (["--images"] if images else []) + ["--", q],
                                150, alive)
            try:
                d = json.loads(o)
                found[q] = d["results"]
                pics.extend({**i, "query": q} for i in d.get("images") or [])
                errors.pop(q, None)
                break
            except (ValueError, KeyError):
                errors[q] = _crawl_error("search", rc, e)
    merged, by_url = [], {}
    for q in qs:                       # keep query order, de-duplicate by URL
        for x in found.get(q, []):
            if x["url"] in by_url:
                by_url[x["url"]]["queries"].append(q)
            else:
                by_url[x["url"]] = {**x, "queries": [q]}
                merged.append(by_url[x["url"]])
    if not merged:
        return {"text": "search failed: " + "; ".join(errors.values() or ["no results"]), "error": True}
    lines = []
    for i, x in enumerate(merged, 1):
        via = f"\n   [found by: {'; '.join(x['queries'])}]" if len(qs) > 1 else ""
        lines.append(f"{i}. {x['title']}\n   {x['url']}\n   {x.get('snippet', '')}{via}")
    head = f"{len(merged)} results for {len(qs)} quer{'y' if len(qs) == 1 else 'ies'}: " + " | ".join(qs)
    errs = "".join(f"\n(query failed: {q}: {m})" for q, m in errors.items())
    imgs = ""
    if images:
        seen = set()
        uniq = [i for i in pics if not (i["url"] in seen or seen.add(i["url"]))]
        imgs = "\n\nImages (view with the download tool):\n" + ("\n".join(
            f"- {i['url']}  ({i['width']}x{i['height']})" for i in uniq[:num * 2]) or "none found")
    return {"text": head + "\n\n" + "\n\n".join(lines) + imgs + errs}


def t_web_fetch(url, max_chars=8000, *, sess, alive):
    url = url.strip()
    if not re.match(r"https?://", url):
        url = "https://" + url
    rc, o, e = _crawler(["fetch", "--meta", "--images", "--timeout", "40000", "--", url], 90, alive)
    text = re.sub(r"\n{3,}", "\n\n", o).strip()
    if not text:
        if rc == 0:
            return {"text": f"fetched {url} but the page has no visible text (JS-only app, login wall or "
                            "bot block). Try a different URL for the same information.", "error": True}
        return {"text": _crawl_error(f"fetch {url}", rc, e), "error": True}
    return {"text": clip(text, max(500, min(int(max_chars or 8000), 30000)))}


def _kwin():
    import dbus
    bus = dbus.SessionBus()
    runner = dbus.Interface(bus.get_object("org.kde.KWin", "/WindowsRunner"), "org.kde.krunner1")
    kwin = dbus.Interface(bus.get_object("org.kde.KWin", "/KWin"), "org.kde.KWin")
    return runner, kwin


def _windows():
    runner, kwin = _kwin()
    seen, out = set(), []
    for m in runner.Match(""):
        uid = str(m[0]).split("_", 1)[1]
        if uid in seen:
            continue
        seen.add(uid)
        try:
            info = {str(k): v for k, v in kwin.getWindowInfo(uid).items()}
        except Exception:
            info = {}
        out.append({"id": uid, "title": str(m[1]), "app": str(info.get("resourceClass", "")),
                    "x": int(info.get("x", 0)), "y": int(info.get("y", 0)),
                    "w": int(info.get("width", 0)), "h": int(info.get("height", 0)),
                    "minimized": bool(info.get("minimized", False))})
    return out


def _active_window_id():
    """Internal id of the focused window, via a one-shot KWin script that prints it to the user journal (KWin has no
    D-Bus call for it). Each call prints a unique tag and waits for that exact line, so journal lag never returns an
    older answer. None when it cannot be read; usually ~0.3 s."""
    import dbus
    tag = "LCHATACTIVE" + secrets.token_hex(4) + ":"
    js = None
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as js:
            js.write(f'print("{tag}" + (workspace.activeWindow ? workspace.activeWindow.internalId : "none"));\n')
        bus = dbus.SessionBus()
        scripting = dbus.Interface(bus.get_object("org.kde.KWin", "/Scripting"), "org.kde.kwin.Scripting")
        sid = scripting.loadScript(js.name)
        script = dbus.Interface(bus.get_object("org.kde.KWin", f"/Scripting/Script{sid}"), "org.kde.kwin.Script")
        script.run()
        try:
            for _ in range(10):
                time.sleep(0.15)
                out = subprocess.run(["journalctl", "--user", "-n", "400", "-o", "cat", "--since", "-30s"],
                                     capture_output=True, text=True, timeout=5).stdout
                ids = [l.split(tag, 1)[1].strip() for l in out.splitlines() if tag in l]
                if ids:
                    return ids[-1] if ids[-1] != "none" else None
            return None
        finally:
            script.stop()
    except Exception:
        return None
    finally:
        if js is not None:
            try:
                os.unlink(js.name)
            except Exception:
                pass


def _find_window(q):
    q = (q or "").strip()
    ws = _windows()
    q0 = q.strip("{}").lower()
    for w in ws:
        if w["id"].strip("{}").lower() == q0:
            return w
    if len(q) < 2:
        raise ValueError("give a window title (at least 2 characters) or an id from list_windows")
    exact = [w for w in ws if w["title"].lower() == q.lower() or w["app"].lower() == q.lower()]
    hits = exact or [w for w in ws if q.lower() in w["title"].lower()]
    if not hits:
        raise ValueError(f"no window matching {q!r}; open windows: " + "; ".join(w["title"] for w in ws))
    if len(hits) > 1:
        raise ValueError(f"{len(hits)} windows match {q!r}, use an id: "
                         + "; ".join(f"{w['title']} id={w['id']}" for w in hits))
    return hits[0]


def t_list_windows(*, sess, alive):
    ws = _windows()
    if not ws:
        return {"text": "no windows"}
    return {"text": "\n".join(f"- {w['title']}  [app {w['app']}, {w['w']}x{w['h']} at {w['x']},{w['y']}"
                              f"{', minimized' if w['minimized'] else ''}] id={w['id']}" for w in ws)}


ACTIONS = {"activate": 0, "close": 1, "minimize": 2, "maximize": 3, "fullscreen": 4}


def t_window_action(window, action, *, sess, alive):
    if action not in ACTIONS:
        raise ValueError(f"action must be one of {list(ACTIONS)}")
    w = _find_window(window)
    _kwin()[0].Run(f"{ACTIONS[action]}_{w['id']}", "")
    return {"text": f"{action}: {w['title']} (id={w['id']})"}


def _shrink(png_bytes, max_w=1280):
    from PIL import Image
    im = Image.open(io.BytesIO(png_bytes)).convert("RGB")
    if im.width > max_w:
        im = im.resize((max_w, round(im.height * max_w / im.width)))
    buf = io.BytesIO()
    im.save(buf, "JPEG", quality=85)
    return im.size, "data:image/jpeg;base64," + base64.b64encode(buf.getvalue()).decode()


SHOT_NOTE = ("The image is attached: answer from what you can actually see in it (window contents, text, files). "
             "Do not web_search to describe the user's screen; if something is unreadable, say so or take a closer "
             "screenshot.")
SHOT_HELPER = os.path.expanduser("~/.local/share/lchat/lchat-shot")   # authorized python copy (see bin/lchat_shot.py)
SHOT_SCRIPT = _first("LCHAT_SHOT_SCRIPT", os.path.join(_HERE, "lchat_shot.py"), "~/.local/share/lchat/lchat_shot.py")


def _shot_window(win_id, out):
    """Capture one window without focusing it (KWin ScreenShot2 through the helper). False when unavailable."""
    if not (os.path.isfile(SHOT_SCRIPT) and os.access(SHOT_HELPER, os.X_OK)):
        return False
    try:
        r = subprocess.run([SHOT_HELPER, "-E", "-P", SHOT_SCRIPT, win_id, out], capture_output=True, timeout=20)
        return r.returncode == 0 and os.path.getsize(out) > 0
    except Exception:
        return False


def t_screenshot(target="screen", *, sess, alive):
    from PIL import Image
    target = (target or "screen").strip()
    with tempfile.TemporaryDirectory() as td:
        f = os.path.join(td, "s.png")
        label, restore = "screen", None
        if target.lower() == "active":
            flag, label = "-a", "active window"
        elif target.lower() in ("screen", "full", "desktop", ""):
            flag = "-f"
        else:
            w = _find_window(target)
            flag, label = "-a", f"window '{w['title']}'"
            # 1) KWin ScreenShot2 via the authorized helper: the window's own pixels, even when it is covered or
            #    minimized, and the user's focus never moves.
            if _shot_window(w["id"], f):
                data = open(f, "rb").read()
                size, url = _shrink(data)
                return {"text": f"screenshot of {label} ({size[0]}x{size[1]}). " + SHOT_NOTE, "image": url}
            # 2) fallback: bring it to the front, capture the active window, then give focus back (cropping a
            #    full-screen grab would show whatever covers the window)
            prev = _active_window_id()
            if prev != w["id"]:
                _kwin()[0].Run(f"0_{w['id']}", "")
                time.sleep(0.7)
                restore = prev
        try:
            r = subprocess.run(["spectacle", "-b", "-n", flag, "-o", f], capture_output=True, timeout=30)
        finally:
            if restore:
                try:
                    _kwin()[0].Run(f"0_{restore}", "")
                except Exception:
                    pass
        if not os.path.exists(f):
            raise RuntimeError("spectacle failed: " + r.stderr.decode(errors="replace")[-300:])
        data = open(f, "rb").read()
    size, url = _shrink(data)
    return {"text": f"screenshot of {label} ({size[0]}x{size[1]}). " + SHOT_NOTE, "image": url}



DOWNLOAD_DIR = os.path.expanduser("~/Downloads/lchat")
MAX_DOWNLOAD = 25 * 1024 * 1024


def t_download(url, max_chars=8000, *, sess, alive):
    url = url.strip()
    if not re.match(r"https?://", url):
        raise ValueError("url must start with http:// or https://")
    req = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0 Safari/537.36",
        "Accept": "*/*"})
    with urllib.request.urlopen(req, timeout=30) as r:
        ctype = (r.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        data = r.read(MAX_DOWNLOAD + 1)
        final = r.geturl()
    if len(data) > MAX_DOWNLOAD:
        raise ValueError(f"larger than {MAX_DOWNLOAD // 1048576} MB, not downloaded")
    name = re.sub(r"[^A-Za-z0-9._-]+", "_", urllib.parse.unquote(final.split("?")[0].rstrip("/").split("/")[-1]))[-80:] or "download"
    os.makedirs(DOWNLOAD_DIR, exist_ok=True)
    path = os.path.join(DOWNLOAD_DIR, f"{time.strftime('%Y%m%d-%H%M%S')}-{name}")
    with open(path, "wb") as f:
        f.write(data)
    size = f"{len(data) / 1024:.0f} KB"
    mc = max(500, min(int(max_chars or 8000), 30000))
    if ctype.startswith("image/") or re.search(r"\.(png|jpe?g|gif|webp|bmp)$", name, re.I):
        try:
            from PIL import Image
            im = Image.open(io.BytesIO(data))
            dims = f"{im.width}x{im.height}"
            buf = io.BytesIO()
            im.convert("RGB").save(buf, "PNG")
            (w, h), img = _shrink(buf.getvalue())
            return {"text": f"image {dims} ({size}, {ctype or 'image'}) saved to {path}", "image": img}
        except Exception as e:
            return {"text": f"saved {path} ({size}) but could not decode it as an image: {e}"}
    if ctype == "application/pdf" or name.lower().endswith(".pdf"):
        r = subprocess.run(["pdftotext", path, "-"], capture_output=True, timeout=60)
        text = re.sub(r"[ \t]+", " ", r.stdout.decode("utf-8", "replace"))
        text = re.sub(r"\n\s*\n+", "\n\n", text).strip()
        return {"text": f"PDF ({size}) saved to {path}\n\n" + (clip(text, mc) if text else "(no extractable text)")}
    if ctype.startswith("text/") or ctype in ("application/json", "application/xml", "application/javascript") \
            or b"\0" not in data[:2048]:
        return {"text": f"{ctype or 'text'} ({size}) saved to {path}\n\n" + clip(data.decode("utf-8", "replace"), mc)}
    return {"text": f"binary file {ctype or '?'} ({size}) saved to {path}"}


# ---------------- chat history (SQLite) + embeddings + rerank ----------------
import sqlite3, struct
import numpy as np

DB_PATH = os.path.join(STATE_DIR, "history.db")
DB_LOCK = threading.Lock()
EMBED_WAKE = threading.Event()
CHUNK, OVERLAP, MAX_CHUNKS = 1200, 200, 20


def db():
    con = sqlite3.connect(DB_PATH, timeout=10, check_same_thread=False)
    con.execute("PRAGMA journal_mode=WAL")
    return con


def db_init():
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    with DB_LOCK, db() as c:
        c.executescript("""
        CREATE TABLE IF NOT EXISTS chats(id TEXT PRIMARY KEY, title TEXT, created REAL, updated REAL);
        CREATE TABLE IF NOT EXISTS messages(chat_id TEXT, seq INTEGER, role TEXT, content TEXT,
            PRIMARY KEY(chat_id, seq));
        CREATE TABLE IF NOT EXISTS chunks(id INTEGER PRIMARY KEY, chat_id TEXT, seq INTEGER, role TEXT,
            text TEXT, vec BLOB);
        CREATE INDEX IF NOT EXISTS chunks_chat ON chunks(chat_id, seq);
        CREATE INDEX IF NOT EXISTS chunks_pending ON chunks(id) WHERE vec IS NULL;
        """)
    os.chmod(DB_PATH, 0o600)


def _strip_images(m):
    c = m.get("content")
    if isinstance(c, list):
        c = [x if x.get("type") != "image_url" else {"type": "text", "text": "[image]"} for x in c]
    return {k: v for k, v in {**m, "content": c}.items() if k in
            ("role", "content", "tool_calls", "tool_call_id", "name", "reasoning_content")}


def _msg_text(m):
    c = m.get("content")
    if isinstance(c, list):
        c = " ".join(x.get("text", "") for x in c if x.get("type") == "text")
    t = (c or "").strip()
    for tc in m.get("tool_calls") or []:
        f = tc.get("function", {})
        t += f"\n[called {f.get('name')}: {f.get('arguments', '')[:300]}]"
    if m.get("role") == "tool":
        t = f"[result of {m.get('name', 'tool')}] " + t
    return t.strip()


def _chunks(text):
    out, i = [], 0
    while i < len(text) and len(out) < MAX_CHUNKS:
        out.append(text[i:i + CHUNK])
        i += CHUNK - OVERLAP
    return out


def history_save(chat, messages):
    cid = str(chat.get("id") or "")[:64]
    if not re.fullmatch(r"[A-Za-z0-9_-]{6,64}", cid):
        raise ValueError("bad chat id")
    title = str(chat.get("title") or "untitled")[:120]
    msgs = [_strip_images(m) for m in messages if isinstance(m, dict)]
    now = time.time()
    with DB_LOCK, db() as c:
        old = {seq: content for seq, content in c.execute(
            "SELECT seq, content FROM messages WHERE chat_id=?", (cid,))}
        c.execute("INSERT INTO chats(id,title,created,updated) VALUES(?,?,?,?) "
                  "ON CONFLICT(id) DO UPDATE SET title=excluded.title, updated=excluded.updated",
                  (cid, title, now, now))
        same = 0
        for seq, m in enumerate(msgs):   # unchanged prefix keeps its chunks and vectors
            if old.get(seq) != json.dumps(m, ensure_ascii=False):
                break
            same = seq + 1
        c.execute("DELETE FROM messages WHERE chat_id=? AND seq>=?", (cid, same))
        c.execute("DELETE FROM chunks WHERE chat_id=? AND seq>=?", (cid, same))
        for seq in range(same, len(msgs)):
            m = msgs[seq]
            c.execute("INSERT INTO messages VALUES(?,?,?,?)",
                      (cid, seq, m.get("role"), json.dumps(m, ensure_ascii=False)))
            for ch in _chunks(_msg_text(m)):
                c.execute("INSERT INTO chunks(chat_id,seq,role,text) VALUES(?,?,?,?)",
                          (cid, seq, m.get("role"), ch))
    EMBED_WAKE.set()
    return {"ok": True, "saved": len(msgs), "new": len(msgs) - same}


def _post(url, payload, timeout=60):
    req = urllib.request.Request(url, json.dumps(payload).encode(), {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def embed(texts):
    d = _post(a.embed.rstrip("/") + "/v1/embeddings", {"input": texts})
    return [np.asarray(x["embedding"], dtype=np.float32) for x in sorted(d["data"], key=lambda x: x["index"])]


def embed_worker():
    """Background: give every chunk without a vector one (retries while the server is down)."""
    while True:
        EMBED_WAKE.wait(30)
        EMBED_WAKE.clear()
        while True:
            with DB_LOCK, db() as c:
                rows = c.execute("SELECT k.id, k.text, k.role, IFNULL(ch.title,'none') FROM chunks k "
                                 "LEFT JOIN chats ch ON ch.id=k.chat_id WHERE k.vec IS NULL LIMIT 16").fetchall()
            if not rows:
                break
            try:
                vecs = embed([f"title: {t} | text: {r}: {x}" for _, x, r, t in rows])
            except Exception:
                break   # server down: try again on the next wake-up
            with DB_LOCK, db() as c:
                c.executemany("UPDATE chunks SET vec=? WHERE id=?",
                              [(v.tobytes(), rid) for v, (rid, *_rest) in zip(vecs, rows)])


def recall_search(query, k=6, chat=None, pool=10):
    """Ranked chunks for a query: (rows, scores, how). Embeddings pick `pool` candidates,
    the reranker orders them; each falls back (keywords / embedding order) when its server is down."""
    with DB_LOCK, db() as c:
        rows = c.execute("SELECT k.id, k.chat_id, k.seq, k.role, k.text, k.vec, ch.title, ch.updated "
                         "FROM chunks k JOIN chats ch ON ch.id=k.chat_id WHERE k.chat_id IS NOT ?",
                         (chat,)).fetchall()
    if not rows:
        return [], [], "empty"
    how = "embeddings"
    try:
        q = embed([f"task: search result | query: {query}"])[0]
        have = [r for r in rows if r[5]]
        M = np.frombuffer(b"".join(r[5] for r in have), dtype=np.float32).reshape(len(have), -1)
        sims = M @ q / (np.linalg.norm(M, axis=1) * np.linalg.norm(q) + 1e-9)
        cand = [have[i] for i in np.argsort(-sims)[:pool]]
    except Exception:
        how = "keywords (embedding server unreachable)"
        words = [w.lower() for w in re.findall(r"\w{3,}", query)]
        cand = sorted(rows, key=lambda r: -sum(r[4].lower().count(w) for w in words))[:pool]
        cand = [r for r in cand if any(w in r[4].lower() for w in words)]
    if not cand:
        return [], [], how
    try:
        d = _post(a.rerank.rstrip("/") + "/v1/rerank", {"query": query, "documents": [r[4] for r in cand]})
        ranked = sorted(d["results"], key=lambda x: -x["relevance_score"])
        how += " + rerank"
        return [cand[x["index"]] for x in ranked[:k]], [x["relevance_score"] for x in ranked[:k]], how
    except Exception:
        return cand[:k], [None] * min(k, len(cand)), how


def t_recall(query, k=6, *, sess, alive, chat=None):
    k = max(1, min(int(k or 6), 15))
    hits, scores, how = recall_search(query, k, chat)
    if how == "empty":
        return {"text": "no saved conversations yet"}
    if not hits:
        return {"text": f"nothing in past conversations matches {query!r}"}
    out = []
    for (_id, cid, seq, role, text, _v, title, upd), sc in zip(hits, scores):
        sc = f" score {sc:.2f}" if sc is not None else ""
        out.append(f"- chat \"{title}\" ({time.strftime('%Y-%m-%d %H:%M', time.localtime(upd))}), "
                   f"message {seq} ({role}){sc}:\n  " + text[:700].replace("\n", "\n  "))
    return {"text": f"{len(out)} matches from past conversations via {how}:\n" + "\n".join(out)}


def history_list():
    with DB_LOCK, db() as c:
        return [{"id": i, "title": t, "updated": u, "messages": n} for i, t, u, n in c.execute(
            "SELECT ch.id, ch.title, ch.updated, COUNT(m.seq) FROM chats ch "
            "LEFT JOIN messages m ON m.chat_id=ch.id GROUP BY ch.id ORDER BY ch.updated DESC LIMIT 200")]


def history_get(cid):
    with DB_LOCK, db() as c:
        ch = c.execute("SELECT id, title, updated FROM chats WHERE id=?", (cid,)).fetchone()
        if not ch:
            raise ValueError("no such chat")
        msgs = [json.loads(x) for (x,) in c.execute(
            "SELECT content FROM messages WHERE chat_id=? ORDER BY seq", (cid,))]
    return {"id": ch[0], "title": ch[1], "updated": ch[2], "messages": msgs}


def history_delete(cid):
    with DB_LOCK, db() as c:
        for t in ("chunks", "messages"):
            c.execute(f"DELETE FROM {t} WHERE chat_id=?", (cid,))
        c.execute("DELETE FROM chats WHERE id=?", (cid,))
    return {"ok": True}


# ---------------- Linux help cards (bin/lchat-cards: own SQLite store, same embedding + rerank servers) ----------------
import importlib.machinery, importlib.util

def _load_cards():
    for p in (os.path.join(_HERE, "lchat-cards"), os.path.expanduser("~/.local/bin/lchat-cards")):
        if os.path.isfile(p):
            ld = importlib.machinery.SourceFileLoader("lchat_cards", p)
            m = importlib.util.module_from_spec(importlib.util.spec_from_loader("lchat_cards", ld))
            ld.exec_module(m)
            return m
    return None


CARDS = _load_cards()
CARDS_MIN_SCORE = 0.3   # best rerank score below this: no card really fits


def cards_worker():
    """Background: bring the card store in line with the installed cards file, then embed what lacks a vector."""
    try:
        r = CARDS.sync(quiet=True)
        if "error" in r:
            print(f"linux_help: {r['error']}")
            return
        if not r.get("unchanged"):
            print(f"linux_help: cards {r['cards']} (version {r['version']}): {r['added']} new, "
                  f"{r['changed']} changed, {r['removed']} removed")
    except Exception as e:
        print(f"linux_help: sync failed: {e}")
        return
    while True:
        try:
            n = CARDS.embed_pending(a.embed)
            if n:
                print(f"linux_help: embedded {n} cards")
            return
        except Exception:
            time.sleep(30)   # embedding server not up yet


AUTO_MIN_SCORE = 0.5   # auto-retrieval (the page, before each user turn) injects cards only above this


def t_linux_help(query, k=3, platform=None, min_score=None, pool=12, *, sess, alive):
    """min_score (used by the page's auto-retrieval): return nothing unless the best card's rerank score reaches it."""
    if CARDS is None:
        return {"text": "error: lchat-cards is not installed (run install.sh)", "error": True}
    k = max(1, min(int(k or 3), 6))
    pool = max(k, min(int(pool or 12), 24))   # rerank cost grows with the pool (~0.3 s per card under load)
    hits, scores, how = CARDS.search(query, k, platform, pool=pool, embed_url=a.embed, rerank_url=a.rerank)
    if how == "empty":
        return {"text": "the card store is empty: run `lchat-cards sync`"}
    if not hits:
        return {"text": f"no help card matches {query!r}; use web_search instead", "cards": 0}
    if min_score is not None and (scores[0] is None or scores[0] < float(min_score)):
        return {"text": "", "cards": 0, "best": scores[0]}
    if min_score is not None:   # auto-retrieval: keep only the cards that clear the bar themselves
        keep = [(c, sc) for c, sc in zip(hits, scores) if sc is not None and sc >= float(min_score)]
        hits, scores = [c for c, _ in keep], [sc for _, sc in keep]
    note = ""
    if scores[0] is not None and scores[0] < CARDS_MIN_SCORE:
        note = (f"NOTE: no card fits well (best score {scores[0]:.2f}). Do not follow these cards blindly; "
                "adapt them or use web_search.\n\n")
    body = "\n\n".join(CARDS.render(c, s) for c, s in zip(hits, scores))
    return {"text": clip(f"{len(hits)} help cards via {how}. Replace <PLACEHOLDERS> with real values; "
                         f"commands marked needs root need sudo.\n\n{note}{body}")}


IMPL = {"bash": t_bash, "read_file": t_read_file, "write_file": t_write_file,
        "web_search": t_web_search, "web_fetch": t_web_fetch, "list_windows": t_list_windows,
        "window_action": t_window_action, "screenshot": t_screenshot, "recall": t_recall, "download": t_download,
        "linux_help": t_linux_help}


def run_tool(name, args, sid, alive, chat=None):
    if name not in IMPL:
        return {"text": f"error: unknown tool {name!r}", "error": True}
    if not isinstance(args, dict):
        return {"text": "error: arguments must be a JSON object", "error": True}
    try:
        extra = {"chat": chat} if name in ("recall", "schedule_task", "manage_task") else {}
        return IMPL[name](**args, sess=session(sid), alive=alive, **extra)
    except Cancelled:
        return {"text": "cancelled by the user", "error": True}
    except TypeError as e:
        return {"text": f"error: bad arguments for {name}: {e}", "error": True}
    except Exception as e:
        return {"text": f"error: {type(e).__name__}: {e}", "error": True}


# ---------------- HTTP ----------------
def _allowed_hosts():
    hosts = {f"127.0.0.1:{a.port}", f"localhost:{a.port}", f"[::1]:{a.port}"}
    if not LOOPBACK:
        hosts.add(f"{a.host}:{a.port}")
    return hosts


ALLOWED_HOSTS = _allowed_hosts()


class H(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def _json(self, code, obj):
        data = json.dumps(obj).encode()
        try:
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _guard(self):
        """Reject DNS-rebinding (foreign Host) and cross-site (foreign Origin) requests."""
        host = (self.headers.get("Host") or "").lower()
        if host not in ALLOWED_HOSTS and not (a.allow_remote_tools and not LOOPBACK):
            self._json(403, {"error": {"message": "bad Host header"}})
            return False
        origin = self.headers.get("Origin")
        if origin and origin.lower() != f"http://{host}":
            self._json(403, {"error": {"message": "cross-origin request refused"}})
            return False
        return True

    def _alive(self):
        """False once the browser has closed the connection (Stop / tab closed)."""
        sock = self.connection
        try:
            r, _, _ = select.select([sock], [], [], 0)
            if r:
                return sock.recv(1, socket.MSG_PEEK) != b""
        except OSError:
            return False
        return True

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(n) if n else None

    def _proxy(self, method):
        body = self._body()
        req = urllib.request.Request(a.llama.rstrip("/") + self.path, body, method=method,
                                     headers={"Content-Type": "application/json"})
        try:
            r = urllib.request.urlopen(req, timeout=600)
        except urllib.error.HTTPError as e:
            r = e
        except OSError as e:
            return self._json(502, {"error": {"message": f"llama unreachable: {e}"}})
        try:
            self.send_response(r.status)
            self.send_header("Content-Type", r.headers.get("Content-Type", "application/json"))
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            while True:
                chunk = r.read1(65536) if hasattr(r, "read1") else r.read(65536)
                if not chunk:
                    break
                self.wfile.write(b"%x\r\n%s\r\n" % (len(chunk), chunk))
                self.wfile.flush()
            self.wfile.write(b"0\r\n\r\n")
        except (BrokenPipeError, ConnectionResetError):
            pass  # browser hit Stop -> closing upstream makes llama abort generation
        except Exception as e:  # upstream died mid-stream: tell the browser, end the response
            try:
                msg = json.dumps({"error": {"message": f"upstream error: {e}"}}).encode()
                line = b"data: " + msg + b"\n\n"
                self.wfile.write(b"%x\r\n%s\r\n0\r\n\r\n" % (len(line), line))
            except OSError:
                pass
            self.close_connection = True
        finally:
            r.close()

    def do_GET(self):
        if not self._guard():
            return
        path = self.path.split("?", 1)[0]
        if path in ("/", "/index.html"):
            data = open(HTML, "rb").read()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("Referrer-Policy", "no-referrer")
            self.end_headers()
            self.wfile.write(data)
        elif path in ("/api/history", "/api/history/get"):
            if not self._authed():
                return self._json(403, {"error": "forbidden"})
            q = urllib.parse.parse_qs(self.path.split("?", 1)[1] if "?" in self.path else "")
            try:
                self._json(200, history_list() if path == "/api/history" else history_get(q.get("id", [""])[0]))
            except Exception as e:
                self._json(404, {"error": str(e)})
        elif path in ("/api/issues", "/api/issues/status"):
            if not self._authed():
                return self._json(403, {"error": "forbidden"})
            self._json(*issues_get(path))
        elif path in SCHED_GET:
            if not self._authed():
                return self._json(403, {"error": "forbidden"})
            try:
                self._json(*sched_get(path, urllib.parse.parse_qs(self.path.split("?", 1)[1] if "?" in self.path else "")))
            except (ValueError, RuntimeError) as e:
                self._json(400, {"error": str(e)})
        elif path == "/api/tools":
            self._json(200, {"enabled": TOOLS_ON, "cwd": DEFAULT_CWD, "system": SYSTEM_INFO,
                             "tools": tool_schemas() if TOOLS_ON else []})
        elif path in PROXY_PATHS:
            self._proxy("GET")
        else:
            self._json(404, {"error": {"message": "not found"}})

    def _authed(self):
        return not TOKEN or secrets.compare_digest(self.headers.get("X-LChat-Token", ""), TOKEN)

    def do_POST(self):
        if not self._guard():
            return
        if self.path in ("/api/history/save", "/api/history/delete"):
            body = self._body()
            if not self._authed():
                return self._json(403, {"error": "forbidden"})
            try:
                req = json.loads(body or b"{}")
                if self.path.endswith("save") and _is_task_chat((req.get("chat") or {}).get("id")):
                    return self._json(409, {"error": "task threads are written by the scheduler only"})
                if self.path.endswith("save"):
                    self._json(200, history_save(req.get("chat") or {}, req.get("messages") or []))
                else:
                    self._json(200, history_delete(str(req.get("id", ""))))
            except Exception as e:
                self._json(400, {"error": f"{type(e).__name__}: {e}"})
            return
        if self.path in SCHED_POST:
            body = self._body()
            if not self._authed():
                return self._json(403, {"error": "forbidden"})
            try:
                self._json(*sched_post(self.path, json.loads(body or b"{}")))
            except (ValueError, RuntimeError, TypeError) as e:
                self._json(400, {"error": str(e)})
            return
        if self.path in ISSUE_POST:
            body = self._body()
            if not self._authed():
                return self._json(403, {"error": "forbidden"})
            try:
                self._json(*issues_post(self.path, json.loads(body or b"{}")))
            except Exception as e:
                self._json(400, {"error": f"{type(e).__name__}: {e}"})
            return
        if self.path == "/api/tool":
            body = self._body()
            if not self._authed():
                return self._json(403, {"text": "forbidden: missing or wrong token (open the URL printed by lchat-web)", "error": True})
            if not TOOLS_ON:
                return self._json(403, {"text": "tools disabled on non-loopback bind", "error": True})
            try:
                req = json.loads(body or b"{}")
            except ValueError:
                return self._json(400, {"text": "bad json", "error": True})
            self._json(200, run_tool(req.get("name"), req.get("args") or {}, req.get("session"), self._alive, req.get("chat")))
        elif self.path == "/v1/chat/completions":
            with CHAT_BUSY_LOCK:
                CHAT_BUSY[0] += 1
            try:
                self._proxy("POST")
            finally:
                with CHAT_BUSY_LOCK:
                    CHAT_BUSY[0] -= 1
        elif self.path in PROXY_PATHS:
            self._proxy("POST")
        else:
            self._json(404, {"error": {"message": "not found"}})


# ===== issues (lchat_watch) =====
# System issue watcher: static detection of log errors, failed services and crashes (no LLM).
WATCHER = None
ISSUE_POST = {"/api/issues/ack", "/api/issues/mute", "/api/issues/unmute", "/api/issues/chat", "/api/issues/link"}


def watcher_start():
    global WATCHER
    import sys
    sys.path.insert(0, _HERE)
    try:
        import lchat_watch
        # only the default instance sends desktop notifications; test instances on other ports stay quiet
        # one DB per instance (like url / url-<port>), so a test instance never touches the real one
        default_db = os.path.join(STATE_DIR, "issues.db" if a.port == 8088 else f"issues-{a.port}.db")
        WATCHER = lchat_watch.Watcher(os.environ.get("LCHAT_ISSUES_DB") or default_db, notify=(a.port == 8088))
        WATCHER.start()
        print("issues: " + ", ".join(f"{s['name']}{'' if s['ok'] else ' (off)'}" for s in WATCHER.status()))
    except Exception as e:
        WATCHER = None
        print(f"issues: watcher disabled ({type(e).__name__}: {e})")


def issues_get(path):
    if WATCHER is None:
        return 503, {"error": "issue watcher not running"}
    if path == "/api/issues/status":
        return 200, {"sources": WATCHER.status()}
    return 200, {"new": WATCHER.new_count(), "groups": WATCHER.list()}


def issues_post(path, req):
    if WATCHER is None:
        return 503, {"error": "issue watcher not running"}
    fp = str(req.get("fp", ""))
    if not fp:
        return 400, {"error": "fp required"}
    act = path.rsplit("/", 1)[1]
    if act == "chat":
        return 200, WATCHER.chat_prompt(fp)
    if act == "link":
        WATCHER.set_chat(fp, str(req.get("chat_id", "")))
    else:
        getattr(WATCHER, act)(fp)
    return 200, {"ok": True, "new": WATCHER.new_count()}
# ===== end issues =====

# ===== tasks (lchat_sched) =====
# Scheduler: periodic and one-shot tasks, each with its own chat thread (chat id task-<n>-<hex>), run unattended by
# a server-side agent loop in bin/lchat_sched.py. Task threads are written only by the server.
SCHED = None
CHAT_BUSY = [0]                      # in-flight interactive /v1/chat/completions requests (the user goes first)
CHAT_BUSY_LOCK = threading.Lock()
SCHED_GET = {"/api/tasks", "/api/tasks/runs"}
SCHED_POST = {"/api/tasks/" + x for x in
              ("preview", "create", "update", "delete", "pause", "resume", "run", "stop", "seen", "ask")}
_SCHED_EX = ('Schedule examples: "every 30 min", "hourly", "daily 09:00", "weekdays 08:30", "weekly mon 10:00", '
             '"in 20 min", "tomorrow 07:00", "once 2026-12-01 18:00", "cron: */15 * * * *", '
             '"каждые 2 часа", "каждый день в 9:00", "по будням в 8:30", "через 20 минут".')
_ACCESS_DESC = ('Access while it runs unattended: "web" (default: web_search, web_fetch, linux_help), '
                '"read" (local only, no web: read_file, list_windows, screenshot, system_facts, linux_help), '
                '"full" (all of them + bash, write_file, download, window_action, recall). Use "full" only when '
                'the task must run commands, change files, or both read local data and use the web.')
TOOLS.update({
    "schedule_task": ("Create a scheduled task that runs later or periodically on its own, without the user watching, "
                      "and reports into its own chat thread. Use it when the user asks to do something at a time, "
                      "every N minutes/hours/days, or regularly. " + _SCHED_EX + " " + _ACCESS_DESC,
                      P("", title={"type": "string", "description": "short name, e.g. 'Disk space check'"},
                        prompt={"type": "string", "description": "what to do on each run, written as a full "
                                "instruction to yourself, e.g. 'Check free space on / and /home; warn if below 10%'"},
                        schedule={"type": "string", "description": "when to run; see the examples"},
                        access={"type": "string", "enum": ["web", "read", "full"], "optional": True}),
                      "always"),
    "list_tasks": ("List the scheduled tasks: id, title, schedule, next run, last status, access.", P(""), False),
    "manage_task": ("Change a scheduled task: action pause | resume | run_now | delete | update. Give the task id "
                    "(e.g. 3 or '#3') or its exact title. For update pass any of schedule, prompt, title, access. "
                    + _SCHED_EX,
                    P("", task={"type": "string", "description": "task id or exact title"},
                      action={"type": "string", "enum": ["pause", "resume", "run_now", "delete", "update"]},
                      schedule={"type": "string", "optional": True}, prompt={"type": "string", "optional": True},
                      title={"type": "string", "optional": True},
                      access={"type": "string", "enum": ["web", "read", "full"], "optional": True}),
                    "always"),
})


def _when(ts):
    return time.strftime("%a %d %b %H:%M", time.localtime(ts)) if ts else "-"


def _task_line(t):
    nxt = _when(t["next_run"]) if t["enabled"] else "paused"
    return (f"#{t['id']} {t['title']} | {t['human']} | next {nxt} | last {t['last_status'] or 'never run'} "
            f"| access {t['access']}")


def _sched_or_err():
    if SCHED is None:
        raise RuntimeError("the scheduler is not running in this lchat-web")
    return SCHED


def t_schedule_task(title, prompt, schedule, access="web", *, sess, alive, chat=None):
    s = _sched_or_err()
    try:
        t = s.create(title, prompt, schedule, access=access or "web", source_chat=chat)
    except ValueError as e:
        return {"text": f"error: {e}", "error": True}
    runs = "; ".join(_when(x) for x in t["next_runs"]) or "none"
    from lchat_sched import LEVEL_TOOLS
    return {"text": f"Created task #{t['id']} '{t['title']}': {t['human']}. Next runs: {runs}. "
                    f"Access: {t['access']} ({', '.join(LEVEL_TOOLS[t['access']])}). Each run reports into the "
                    f"task's own chat (Tasks in the sidebar). Tasks run only while lchat is running."}


def t_list_tasks(*, sess, alive):
    s = _sched_or_err()
    ts = s.list()
    return {"text": "\n".join(_task_line(t) for t in ts) if ts else "no scheduled tasks"}


def t_manage_task(task, action, schedule=None, prompt=None, title=None, access=None, *, sess, alive, chat=None):
    s = _sched_or_err()
    try:
        tid = s.resolve(task)
        if action == "delete":
            r = s.delete(tid)
            if r.get("delete_chat"):
                history_delete(r["chat_id"])
            return {"text": f"deleted task #{tid} and its chat"}
        if action == "update":
            fields = {k: v for k, v in (("schedule", schedule), ("prompt", prompt), ("title", title),
                                        ("access", access)) if v}
            if not fields:
                return {"text": "error: update needs at least one of schedule, prompt, title, access", "error": True}
            s.update(tid, **fields)
        elif action == "pause":
            s.pause(tid)
        elif action == "resume":
            s.resume(tid)
        elif action == "run_now":
            s.run_now(tid)
        else:
            return {"text": f"error: unknown action {action!r}", "error": True}
        return {"text": f"{action}: " + _task_line(s.get(tid))}
    except (ValueError, RuntimeError) as e:
        return {"text": f"error: {e}", "error": True}


IMPL.update({"schedule_task": t_schedule_task, "list_tasks": t_list_tasks, "manage_task": t_manage_task})


def _sched_llm(messages, tools, timeout=180, alive=lambda: True):
    """One streamed chat completion, accumulated. The HTTP exchange runs in a helper thread so Stop and the deadline
    are checked every 0.25 s even while llama is still busy with someone else's request (-np 1); on cancel the socket
    is shut down, which makes llama abort the generation."""
    import http.client, queue
    payload = {"messages": messages, "stream": True, "max_tokens": 4096}
    if tools:
        payload["tools"] = tools
    u = urllib.parse.urlsplit(a.llama)
    conn = http.client.HTTPConnection(u.hostname, u.port or 80, timeout=timeout + 5)
    lines = queue.Queue()
    done = threading.Event()            # set when the caller gives up: pump must not start the request then

    def pump():
        try:
            if done.is_set():
                return
            conn.request("POST", (u.path.rstrip("/") or "") + "/v1/chat/completions", json.dumps(payload).encode(),
                         {"Content-Type": "application/json"})
            r = conn.getresponse()
            if r.status != 200:
                lines.put(RuntimeError(f"llama HTTP {r.status}: {r.read(500).decode('utf-8', 'replace')}"))
                return
            for raw in r:
                lines.put(raw)
        except Exception as e:
            lines.put(e)
        finally:
            lines.put(None)

    threading.Thread(target=pump, daemon=True).start()
    end = time.time() + timeout
    out = {"content": "", "reasoning_content": "", "tool_calls": [], "finish_reason": None}
    calls = {}
    try:
        while True:
            if not alive():
                raise Cancelled()
            if time.time() > end:
                raise TimeoutError(f"model reply took longer than {int(timeout)}s")
            try:
                raw = lines.get(timeout=0.25)
            except queue.Empty:
                continue
            if raw is None:
                break
            if isinstance(raw, Exception):
                raise raw
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            ev = json.loads(data)
            if ev.get("error"):
                raise RuntimeError(str(ev["error"].get("message", ev["error"])))
            for ch in ev.get("choices") or []:
                d = ch.get("delta") or {}
                out["content"] += d.get("content") or ""
                out["reasoning_content"] += d.get("reasoning_content") or ""
                for tc in d.get("tool_calls") or []:
                    c = calls.setdefault(tc.get("index", 0), {"id": "", "type": "function",
                                                              "function": {"name": "", "arguments": ""}})
                    c["id"] = tc.get("id") or c["id"]
                    f = tc.get("function") or {}
                    c["function"]["name"] += f.get("name") or ""
                    c["function"]["arguments"] += f.get("arguments") or ""
                if ch.get("finish_reason"):
                    out["finish_reason"] = ch["finish_reason"]
    finally:
        done.set()
        try:
            if conn.sock is not None:
                conn.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        conn.close()
    out["tool_calls"] = [calls[i] for i in sorted(calls)]
    for i, c in enumerate(out["tool_calls"]):
        c["id"] = c["id"] or f"call_{secrets.token_hex(6)}"
    return out


def _sched_notify(title, body):
    if a.port != 8088:          # test instances stay quiet
        return
    try:
        subprocess.Popen(["notify-send", "-a", "lchat", "-i", "alarm-symbolic", title, body[:300]],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def sched_start():
    global SCHED
    import sys
    sys.path.insert(0, _HERE)
    try:
        import lchat_sched
        SCHED = lchat_sched.Scheduler(
            os.path.join(STATE_DIR, "tasks.db"), llm=_sched_llm, run_tool=run_tool, tool_schemas=tool_schemas,
            history_save=history_save, history_get=history_get,
            system_prompt=lambda: lchat_sched.default_system_prompt(DEFAULT_CWD, SYSTEM_INFO),
            busy=lambda: CHAT_BUSY[0], notify=_sched_notify, cwd=DEFAULT_CWD)
        SCHED.start()
        print("tasks: " + SCHED.status_line())
    except Exception as e:
        SCHED = None
        print(f"tasks: scheduler disabled ({type(e).__name__}: {e})")


def _is_task_chat(cid):
    return str(cid or "").startswith("task-")


def sched_get(path, qs):
    if SCHED is None:
        return 503, {"error": "scheduler not running"}
    if path == "/api/tasks/runs":
        return 200, {"runs": SCHED.runs(SCHED.resolve(qs.get("id", [""])[0]))}
    return 200, {"engine": SCHED.engine_on, "status": SCHED.status_line(), "tasks": SCHED.list()}


def sched_post(path, req):
    if SCHED is None:
        return 503, {"error": "scheduler not running"}
    act = path.rsplit("/", 1)[1]
    if act == "preview":
        return 200, SCHED.preview(str(req.get("schedule", "")))
    if act == "create":
        return 200, SCHED.create(req.get("title", ""), req.get("prompt", ""), str(req.get("schedule", "")),
                                 access=req.get("access") or "web")
    tid = SCHED.resolve(req.get("id", ""))
    if act == "update":
        fields = {k: req[k] for k in ("title", "prompt", "schedule", "access") if req.get(k)}
        SCHED.update(tid, **fields)
    elif act == "delete":
        r = SCHED.delete(tid, keep_chat=bool(req.get("keep_chat")))
        if r.get("delete_chat"):
            history_delete(r["chat_id"])
        return 200, r
    elif act == "run":
        SCHED.run_now(tid)
    elif act == "ask":
        text = str(req.get("text", "")).strip()
        if not text:
            return 400, {"error": "text required"}
        SCHED.ask(tid, text)
    else:   # pause resume stop seen
        getattr(SCHED, act)(tid)
    return 200, SCHED.get(tid)
# ===== end tasks =====

class S(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


if __name__ == "__main__":
    url = f"http://{'127.0.0.1' if LOOPBACK else a.host}:{a.port}/" + (f"#{TOKEN}" if TOKEN else "")
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    # the default instance writes "url"; others "url-<port>" so test instances never clobber it
    fd = os.open(os.path.join(STATE_DIR, "url" if a.port == 8088 else f"url-{a.port}"),
                 os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(url + "\n")
    db_init()
    threading.Thread(target=embed_worker, daemon=True).start()
    EMBED_WAKE.set()
    if CARDS is not None:
        threading.Thread(target=cards_worker, daemon=True).start()
    if a.no_watch:
        pass
    elif not LOOPBACK and not TOKEN:   # journal contents must not be served to the network without a token
        print("issues: watcher off (non-loopback bind without --token)")
    else:
        watcher_start()
    # SIGTERM (lchat-run stop, systemd) -> normal exit, so the watcher can stop its journalctl/log children
    def _term(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, _term)
    if a.no_sched or (a.port != 8088 and not a.sched):   # test instances never own or run real tasks
        print("tasks: scheduler off" + ("" if a.no_sched else " (non-default port; pass --sched to run it)"))
    elif not TOOLS_ON or (not LOOPBACK and not TOKEN):   # unattended tool runs follow the tools gate
        print("tasks: scheduler off (tools are off on a non-loopback bind; see --allow-remote-tools, --token)")
    else:
        sched_start()
    print(f"history: {DB_PATH}  (embed {a.embed}, rerank {a.rerank})")
    print(f"lchat-web -> {a.llama}  (tools {'ON' if TOOLS_ON else 'OFF'}, cwd {DEFAULT_CWD})")
    print(f"open: {url}")
    try:
        S((a.host, a.port), H).serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        if WATCHER is not None:
            WATCHER.stop()
        if SCHED is not None:
            SCHED.close()
