import platform as _platform, shutil as _shutil, glob as _glob, sys
from concurrent.futures import ThreadPoolExecutor as _Pool

MACOS = sys.platform == "darwin"
# native package manager per os-release family (ID, then ID_LIKE)
_PKG_BY_FAMILY = [("arch", "pacman"), ("debian", "apt"), ("ubuntu", "apt"), ("fedora", "dnf"), ("rhel", "dnf"),
                  ("suse", "zypper"), ("opensuse", "zypper"), ("alpine", "apk"), ("gentoo", "emerge"),
                  ("void", "xbps-install"), ("nix", "nix"), ("nixos", "nix")]
_PMS = ("pacman", "apt", "dnf", "zypper", "apk", "emerge", "xbps-install", "nix", "flatpak", "snap", "brew", "port",
        "paru", "yay", "pip", "pipx", "uv", "distrobox")
_CONTAINERS = ("docker", "podman", "nerdctl", "colima", "lima")
_K8S = ("kubectl", "helm", "k3s", "minikube", "kind", "k9s")
_VPN_TOOLS = ("tailscale", "wg", "openvpn", "openconnect", "nordvpn", "mullvad", "protonvpn", "warp-cli")
# a service or Finder-started app gets a minimal PATH: look in the usual install prefixes too
_EXTRA_DIRS = ["/usr/local/bin", "/opt/homebrew/bin", "/home/linuxbrew/.linuxbrew/bin",
               os.path.expanduser("~/.linuxbrew/bin"), os.path.expanduser("~/.local/bin"), "/snap/bin",
               "/Applications/Docker.app/Contents/Resources/bin", "/Applications/Tailscale.app/Contents/MacOS"]
_VERSION_ARGS = {"pacman": ["-V"], "kubectl": ["version", "--client"], "helm": ["version", "--short"],
                 "minikube": ["version"], "kind": ["version"], "k9s": ["version", "-s"], "colima": ["version"],
                 "lima": ["--version"], "tailscale": ["version"], "nordvpn": ["version"], "mullvad": ["version"]}
_PORTABLE_CHASSIS = {"8", "9", "10", "11", "14", "30", "31", "32"}   # SMBIOS: portable, laptop, notebook, handheld...


def _cmd(argv, timeout=3):
    """stdout of a probe command, '' when it is missing, fails or is slow."""
    try:
        return subprocess.run(argv, capture_output=True, text=True, errors="replace", timeout=timeout,
                              stdin=subprocess.DEVNULL).stdout.strip()
    except Exception:
        return ""


def _read(path):
    try:
        return open(path, encoding="utf-8", errors="replace").read().strip()
    except OSError:
        return ""


def _find(name):
    """path of a command: PATH, then the usual prefixes, then /opt/<x>/[bin/]name."""
    p = _shutil.which(name)
    if p:
        return p
    for d in _EXTRA_DIRS + sorted(_glob.glob("/opt/*/bin")) + sorted(_glob.glob("/opt/*")):
        c = os.path.join(d, name)
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def _version(name, path):
    out = _cmd([path] + _VERSION_ARGS.get(name, ["--version"]), timeout=4)
    v = re.search(r"\d+\.\d+(?:\.\d+)?", out)
    return f"{name} {v.group(0) if v else '?'} at {path}"


def _timezone():
    tz = os.path.realpath("/etc/localtime")
    return tz.split("zoneinfo/", 1)[1] if "zoneinfo/" in tz else os.environ.get("TZ", "")


def _linux_os():
    osr = {}
    for line in _read("/etc/os-release").splitlines():
        k, _, v = line.partition("=")
        osr[k] = v.strip('"')
    ids = [osr.get("ID", "")] + osr.get("ID_LIKE", "").split()
    name = osr.get("PRETTY_NAME") or osr.get("NAME") or _platform.system()
    ver = osr.get("VERSION_ID", "")
    fam = ", ".join(x for x in ids[1:] if x) or ids[0] or "unknown"
    desc = (f"OS: {name}{' ' + ver if ver and ver not in name else ''} (id {ids[0] or '?'}, family {fam})"
            + (f", variant {osr['VARIANT_ID']}" if osr.get("VARIANT_ID") else ""))
    native = next((pm for fam_ in ids for f, pm in _PKG_BY_FAMILY if fam_ == f and _shutil.which(pm)), None)
    return desc, native


def _linux_gpu():
    short = lambda v: re.sub(r"^(Advanced Micro Devices|NVIDIA|Intel|Matrox|ASPEED|VMware|Red Hat|Qualcomm).*", r"\1", v)
    names = [f"{f[2]} ({short(f[1]).replace('Advanced Micro Devices', 'AMD')})" for l in _cmd(["lspci", "-mm"]).splitlines()
             if re.search(r'"(VGA|3D|Display)', l) for f in [re.findall(r'"([^"]*)"', l)] if len(f) >= 3]
    drivers = sorted({m.group(1) for f in _glob.glob("/sys/class/drm/card[0-9]*/device/uevent")
                      for m in [re.search(r"^DRIVER=(\S+)", _read(f), re.M)] if m})
    if not names and not drivers:
        return ""
    return "GPU " + ("; ".join(names) or "?") + (f" (driver {', '.join(drivers)})" if drivers else "")


def _linux_hw():
    bats = _glob.glob("/sys/class/power_supply/BAT*")
    chassis = _read("/sys/class/dmi/id/chassis_type")
    model = " ".join(x for x in (_read("/sys/class/dmi/id/sys_vendor"), _read("/sys/class/dmi/id/product_name"))
                     if x and "o be filled" not in x)
    kind = "laptop/handheld (has a battery)" if bats or chassis in _PORTABLE_CHASSIS else "desktop (no battery)"
    return f"hardware {model + ', ' if model else ''}{kind}"


def _vpn_ifaces():
    return sorted(n for n in os.listdir("/sys/class/net")
                  if re.match(r"(wg|tun|tap|tailscale|ppp|proton|nordlynx|mullvad|utun|ipsec|zt)", n)) \
        if os.path.isdir("/sys/class/net") else []


def _linux_stack():
    parts = []
    srv = re.search(r"Server Name:\s*(.+)", _cmd(["pactl", "info"]))
    if srv and "pipewire" in srv.group(1).lower():
        v = re.search(r"PipeWire ([\d.]+)", srv.group(1))
        parts.append(f"audio PipeWire{' ' + v.group(1) if v else ''} (pipewire-pulse emulates PulseAudio, so pactl works - "
                     "restart audio with `systemctl --user restart pipewire pipewire-pulse wireplumber`, never pulseaudio -k)")
    elif srv:
        parts.append(f"audio {srv.group(1).strip()}")
    elif _shutil.which("pipewire"):
        parts.append("audio PipeWire")
    nets = [u for u, st in zip(("NetworkManager", "iwd", "systemd-networkd", "connman"),
                               _cmd(["systemctl", "is-active", "NetworkManager", "iwd", "systemd-networkd",
                                     "connman"]).split()) if st == "active"]
    if nets:
        parts.append("network " + ", ".join(nets))
    init = _read("/proc/1/comm")
    if init:
        parts.append(f"init {init}")
    return parts


def _vpn_summary():
    """configured VPN connections (names only) and which are up."""
    conf = []
    if MACOS:
        for l in _cmd(["scutil", "--nc", "list"]).splitlines():
            m = re.search(r"\((\w+)\).*\"([^\"]+)\"(?:\s*\[([^\]]+)\])?", l)   # * (Connected) id .. "Name" [PPP/L2TP]
            if m:
                conf.append(f"{m.group(2)} ({m.group(3) + ', ' if m.group(3) else ''}{m.group(1).lower()})")
    else:
        for l in _cmd(["nmcli", "-t", "-f", "NAME,TYPE,ACTIVE", "connection", "show"]).splitlines():
            f = l.split(":")   # NAME may contain ':'; TYPE and ACTIVE are the last two fields
            if len(f) >= 3 and re.search(r"vpn|wireguard", f[-2]):
                conf.append(f"{':'.join(f[:-2])} ({f[-2]}{', active' if f[-1] == 'yes' else ''})")
        for u in _cmd(["systemctl", "list-units", "--all", "--plain", "--no-legend", "wg-quick@*", "openvpn*@*",
                       "openvpn-client@*"]).splitlines():
            f = u.split()
            if f:
                conf.append(f"{f[0]} ({f[2]})")
    up = _vpn_ifaces()
    ts = _find("tailscale")
    if ts:
        st = _cmd([ts, "status", "--peers=false"], timeout=3)
        conf.append("tailscale (" + ("connected" if re.match(r"\d+\.\d+\.\d+\.\d+", st) else
                                     "stopped" if "stopped" in st.lower() else "not running") + ")")
    if not conf and not up:
        return ""
    return ("VPN: " + (", ".join(dict.fromkeys(conf)) or "none configured")
            + (f"; tunnel interfaces up: {', '.join(up)}" if up else ""))


def _docker_daemon():
    socks = [os.environ.get("DOCKER_HOST", "").replace("unix://", ""), "/var/run/docker.sock", "/run/docker.sock",
             os.path.expanduser("~/.docker/run/docker.sock"), os.path.expanduser("~/.colima/default/docker.sock")]
    s = next((s for s in socks if s and os.path.exists(s)), None)
    if not s:
        return "daemon not running (no socket)"
    return "daemon running" + ("" if os.access(s, os.R_OK | os.W_OK) else ", socket needs root (use sudo or the docker group)")


def _mac_os():
    v = _cmd(["sw_vers", "-productVersion"]) or _platform.mac_ver()[0]
    b = _cmd(["sw_vers", "-buildVersion"])
    chip = _cmd(["sysctl", "-n", "machdep.cpu.brand_string"])
    model = _cmd(["sysctl", "-n", "hw.model"])
    arm = _cmd(["sysctl", "-n", "hw.optional.arm64"]) == "1"
    rosetta = _cmd(["sysctl", "-n", "sysctl.proc_translated"]) == "1"
    batt = "InternalBattery" in _cmd(["pmset", "-g", "batt"])
    desc = (f"OS: macOS {v or '?'}{' (' + b + ')' if b else ''}" + ("; NOTE lchat runs under Rosetta (x86_64 Python) "
            "but the machine is arm64: brew lives in /opt/homebrew" if rosetta else ""))
    hw = (f"hardware {'Apple Silicon' if arm else 'Intel'} Mac{' ' + model if model else ''}"
          f"{', ' + chip if chip else ''}, {'laptop (has a battery)' if batt else 'desktop (no battery)'}")
    loc = _cmd(["defaults", "read", "-g", "AppleLocale"])
    return desc, [hw, "audio CoreAudio", "init launchd"] + ([f"locale {loc}"] if loc else [])


def system_info():
    """One paragraph about this machine for the agent prompt: OS, kernel, hardware model and kind, GPU,
    audio/network stack, VPNs, package managers / container / kubernetes tools with version and location,
    locale, read-only rootfs, CPU/RAM. Linux and macOS. Detected once at start-up; every probe is optional
    and time-limited; the slow ones (version queries) run in parallel."""
    with _Pool(10) as pool:
        def tools(names):
            return [pool.submit(_version, n, p) for n in names for p in [_find(n)] if p]
        f_pms, f_ctr, f_k8s, f_vpnt = tools(_PMS), tools(_CONTAINERS), tools(_K8S), tools(_VPN_TOOLS)
        f_vpn = pool.submit(_vpn_summary)
        if MACOS:
            f_os, f_gpu, f_stack = pool.submit(_mac_os), None, None
        else:
            f_os, f_gpu, f_stack = pool.submit(_linux_os), pool.submit(_linux_gpu), pool.submit(_linux_stack)
        os_desc, extra = f_os.result()
        pms = [f.result() for f in f_pms]
        arch = _platform.machine()
        dl = "x86_64/amd64" if arch in ("x86_64", "AMD64") else "arm64/aarch64" if arch in ("arm64", "aarch64") else arch
        parts = [os_desc, f"kernel {_platform.system()} {_platform.release()}",
                 f"CPU architecture {arch}: pick {dl} downloads and builds"]
        if MACOS:
            native = "brew" if any(p.startswith("brew ") for p in pms) else None
            parts += extra
        else:
            native = extra
            parts.append(_linux_hw())
            if f_gpu.result():
                parts.append(f_gpu.result())
            parts += f_stack.result()
        if f_vpn.result():
            parts.append(f_vpn.result())
        ctr = [f.result() for f in f_ctr]
        k8s = [f.result() for f in f_k8s]
        vpnt = [f.result() for f in f_vpnt]
    de, st = os.environ.get("XDG_CURRENT_DESKTOP", ""), os.environ.get("XDG_SESSION_TYPE", "")
    if de or st:
        parts.append(f"desktop {de or '?'} on {st or '?'}")
    parts.append(f"native package manager: {native or 'unknown'}" + (f" (installed: {', '.join(pms)})" if pms else ""))
    if ctr:
        dk = " - docker " + _docker_daemon() if any(c.startswith("docker ") for c in ctr) else ""
        parts.append(f"containers: {', '.join(ctr)}{dk}")
    if k8s:
        ctx = _cmd([_find("kubectl"), "config", "current-context"]) if _find("kubectl") else ""
        parts.append(f"kubernetes: {', '.join(k8s)}" + (f", current context {ctx}" if ctx else ", no kube context"))
    if vpnt:
        parts.append(f"VPN tools: {', '.join(vpnt)}")
    if not MACOS:
        loc = os.environ.get("LC_ALL") or os.environ.get("LANG", "")
        if loc:
            parts.append(f"locale {loc}")
    tz = _timezone()
    if tz:
        parts.append(f"timezone {tz}")
    if _shutil.which("steamos-readonly"):
        ro = _cmd(["steamos-readonly", "status"], timeout=5)
        if ro:
            parts.append(f"SteamOS read-only root filesystem: {ro} - system packages installed with pacman are wiped "
                         "by OS updates; prefer flatpak (apps), distrobox, pip --user or ~/.local for tools, and "
                         "only use `sudo steamos-readonly disable` + pacman when the user agrees")
    try:
        if MACOS:
            mem, cpu = int(_cmd(["sysctl", "-n", "hw.memsize"]) or 0) // 2**20, ""   # chip named in hardware part
        else:
            mem = next(int(l.split()[1]) for l in open("/proc/meminfo") if l.startswith("MemTotal")) // 1024
            cpu = next((l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name")), "")
        parts.append(f"{os.cpu_count()} CPUs{' (' + cpu + ')' if cpu else ''}, {mem / 1024:.0f} GiB RAM")
    except Exception:
        pass
    parts.append(f"shell {os.path.basename(os.environ.get('SHELL', 'bash'))} (the bash tool runs bash), "
                 f"user {os.environ.get('USER', '?')}, "
                 f"sudo {'present (ask the user before using it)' if _shutil.which('sudo') else 'missing'}")
    return "; ".join(parts) + "."


SYSTEM_INFO = system_info()


# ---------------- package management guide for the agent prompt ----------------
# Commands per manager: search / info / install / update / remove / owner of a file / list files / installed?
_PKG_CMDS = {
    "pacman": ("pacman -Ss <name>", "pacman -Si <pkg>", "sudo pacman -S <pkg>",
               "sudo pacman -Syu (whole system; never `pacman -Sy <pkg>` alone: partial upgrades break Arch)",
               "sudo pacman -Rns <pkg>", "pacman -Qo <path>", "pacman -Ql <pkg>", "pacman -Qi <pkg>"),
    "paru": ("paru -Ss <name>", "paru -Si <pkg>", "paru -S <pkg> (AUR, no sudo)", "paru -Sua (AUR only)",
             "paru -Rns <pkg>", None, None, None),
    "yay": ("yay -Ss <name>", "yay -Si <pkg>", "yay -S <pkg> (AUR, no sudo)", "yay -Sua (AUR only)",
            "yay -Rns <pkg>", None, None, None),
