#!/usr/bin/env python3
"""lchat-web: tiny agentic web chat for a llama.cpp server (run llama with --no-webui).

Serves ~/.local/share/lchat/index.html, proxies the chat API to llama, and
executes agent tools on this machine via POST /api/tool:
  bash, read_file, write_file, web_search, web_fetch, download, recall,
  linux_help (help cards, bin/lchat-cards), list_windows, window_action, screenshot

Usage: lchat-web [--llama http://127.0.0.1:9941] [--port 8088] [--host 127.0.0.1]
                 [--cwd DIR] [--allow-remote-tools]

Security model
- No login by default: open http://127.0.0.1:8088/. With --token, tools and history need a per-launch
  token, which is NEVER served over HTTP: it is printed at startup as part of the URL fragment
  (http://127.0.0.1:8088/#<token>) and written to ~/.local/state/lchat/url (url-<port> for a
  non-default port, mode 600). Without --token any local process can call the tools (bash).
- Every request must carry a Host header naming this server and, if present, a
  same-origin Origin header (blocks DNS rebinding and cross-site requests).
- Only an exact allowlist of llama endpoints is proxied.
- Tools run only on a loopback bind unless --allow-remote-tools is given.
"""
import argparse, base64, http.server, io, json, os, re, secrets, select, signal, socket
import socketserver, stat, subprocess, tempfile, threading, time, urllib.error, urllib.parse, urllib.request

ap = argparse.ArgumentParser()
ap.add_argument("--llama", default=os.environ.get("LCHAT_URL", "http://127.0.0.1:9931"))
ap.add_argument("--embed", default="http://127.0.0.1:9951", help="llama-server --embedding (EmbeddingGemma 2)")
ap.add_argument("--rerank", default="http://127.0.0.1:9952", help="llama-server --reranking (Qwen3-Reranker)")
ap.add_argument("--port", type=int, default=8088)
ap.add_argument("--host", default="127.0.0.1")
ap.add_argument("--cwd", default=os.path.expanduser("~"))
ap.add_argument("--allow-remote-tools", action="store_true")
ap.add_argument("--token", action="store_true",
                help="require a per-launch token (in the URL fragment) for tools and history; off by default")
ap.add_argument("--no-watch", action="store_true", help="do not run the system issue watcher (bin/lchat_watch.py)")
ap.add_argument("--no-sched", action="store_true", help="do not run the task scheduler (bin/lchat_sched.py)")
ap.add_argument("--sched", action="store_true",
                help="run the task scheduler on a non-default port too (by default only port 8088 runs tasks)")
a = ap.parse_args()

_HERE = os.path.dirname(os.path.realpath(__file__))


def _first(env, *paths):
    """$env if set, else the first path that exists (else the last one, for the error message)."""
    paths = [os.path.expanduser(p) for p in paths]
    return os.environ.get(env) or next((p for p in paths if os.path.exists(p)), paths[-1])


# works from a repo checkout (bin/ + web/ + vendor/) and from an install (~/.local/...)
HTML = _first("LCHAT_HTML", os.path.join(_HERE, "..", "web", "index.html"), "~/.local/share/lchat/index.html")
WEBCRAWLER = _first("LCHAT_WEBCRAWLER", "~/.agents/skills/webcrawler/webcrawler.py",
                    os.path.join(_HERE, "..", "vendor", "webcrawler", "webcrawler.py"),
                    "~/.local/share/lchat/webcrawler/webcrawler.py")
STATE_DIR = os.path.expanduser("~/.local/state/lchat")
TOKEN = secrets.token_urlsafe(24) if a.token else ""   # "" = no token check
LOOPBACK = a.host in ("127.0.0.1", "localhost", "::1")
TOOLS_ON = a.allow_remote_tools or LOOPBACK
MAX_OUT = 12000
MAX_CAPTURE = 4 * 1024 * 1024        # bytes of command output kept on disk/read back
MAX_READ = 2 * 1024 * 1024           # bytes read_file will scan
DEFAULT_CWD = os.path.abspath(os.path.expanduser(a.cwd))
PROXY_PATHS = {"/v1/chat/completions", "/v1/models", "/props", "/health"}
SESSIONS = {}                        # session id -> {"cwd": str}
SESSIONS_LOCK = threading.Lock()


def clip(s, n=MAX_OUT):
    if len(s) <= n:
        return s
    h = n * 2 // 3
    return s[:h] + f"\n…[{len(s) - n} chars truncated]…\n" + s[-(n - h):]


def P(desc, **props):
    req = [k for k, v in props.items() if not v.pop("optional", False)]
    return {"type": "object", "properties": props, "required": req}


# name -> (description, parameters, needs_approval)
