 "steps": [
  {
   "explain": "Query the value of a specific key within a schema. Replace the placeholders with the actual schema ID (e.g., org.gnome.desktop.interface) and key name (e.g., gtk-theme).",
   "cmd": "gsettings get <SCHEMA_ID> <KEY_NAME>",
   "risk": "low",
   "placeholders": [
    {
     "name": "SCHEMA_ID",
     "description": "The schema ID, e.g., org.gnome.desktop.interface",
     "example": "org.gnome.desktop.interface"
    },
    {
     "name": "KEY_NAME",
     "description": "The key name, e.g., gtk-theme",
     "example": "gtk-theme"
    }
   ]
  }
 ],
 "risk": "low",
