   "explain": "Set the default web browser to the specified .desktop file. You can find the correct .desktop file name in /usr/share/applications/.",
   "cmd": "xdg-settings set default-web-browser <DESKTOP_FILE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "DESKTOP_FILE",
     "description": "The .desktop file name of the browser you want to set as default (e.g., firefox.desktop, google-chrome.desktop).",
     "example": "firefox.desktop",
     "discover_cmd": "ls /usr/share/applications/*.desktop"
    }
   ]
  }
 ],
