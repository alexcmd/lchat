   "lang": "ru"
  },
  {
   "text": "отключить диск",
   "lang": "ru"
  },
  {
   "text": "unmount drive/en",
   "lang": "en"
  },
  {
   "text": "размонтировать/ru",
   "lang": "ru"
  },
  {
   "text": "unmount drive",
   "lang": "en"
  },
  {
   "text": "eject usb",
   "lang": "en"
  },
  {
   "text": "detach filesystem",
   "lang": "en"
