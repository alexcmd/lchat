 "id": "fs-unmount",
 "platform": "linux",
 "kind": "task",
 "title": "Unmount a file system",
 "summary": "Detach a file system from its mount point so it can be safely removed or formatted.",
 "aliases": [
  {
   "text": "unmount partition",
   "lang": "en"
  },
