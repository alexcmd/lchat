   "explain": "Install the specified package(s). You will be prompted to confirm the installation unless you use --assumeyes.",
   "cmd": "sudo dnf install <PACKAGE>",
   "needs_root": true,
   "risk": "medium",
   "placeholders": [
    {
     "name": "PACKAGE",
     "description": "Name of the package to install",
     "example": "firefox"
    }
   ],
   "alternatives": [
    {
     "explain": "Install multiple packages at once.",
     "cmd": "sudo dnf install <PACKAGE1> <PACKAGE2>",
     "needs_root": true,
     "risk": "medium",
     "placeholders": [
      {
       "name": "PACKAGE1",
       "description": "First package name",
       "example": "vim"
      },
      {
       "name": "PACKAGE2",
       "description": "Second package name",
       "example": "git"
      }
     ]
    }
   ]
  }
 ],
 "risk": "medium",
 "rollback": [
  {
   "explain": "Remove the package if you made a mistake.",
   "cmd": "sudo dnf remove <PACKAGE>",
   "needs_root": true,
   "risk": "medium",
   "placeholders": [
    {
     "name": "PACKAGE",
     "description": "Name of the package to remove",
     "example": "firefox"
    }
   ]
  }
 ],
