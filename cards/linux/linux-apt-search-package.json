 "steps": [
  {
   "explain": "Searches the package database for packages matching the given term in name or description.",
   "cmd": "apt search <PACKAGE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "PACKAGE",
     "description": "The keyword or package name to search for.",
     "example": "firefox"
    }
   ],
   "alternatives": [
    {
     "explain": "Search the package database for keywords related to the software you need.",
     "cmd": "apt-cache search <QUERY>",
     "placeholders": [
      {
       "name": "QUERY",
       "description": "Keywords to search for",
       "example": "image editor"
      }
     ],
     "risk": "low"
    },
    {
     "explain": "Searches for packages matching the given term.",
     "cmd": "aptitude search <PACKAGE>",
     "placeholders": [
      {
       "name": "PACKAGE",
       "description": "The name or keyword to search for",
       "example": "vim"
      }
     ],
     "risk": "low"
    },
    {
     "explain": "Search for packages matching the given pattern. By default, it uses regex.",
     "cmd": "nala search \"<PATTERN>\"",
     "placeholders": [
      {
       "name": "PATTERN",
       "description": "Search term, regex, or glob pattern",
       "example": "firefox"
      }
     ],
     "risk": "low"
    }
   ]
  }
 ],
