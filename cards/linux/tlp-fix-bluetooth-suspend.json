{
 "schema_version": 2,
 "id": "tlp-fix-bluetooth-suspend",
 "platform": "linux",
 "kind": "error",
 "title": "Fix Bluetooth disconnects caused by TLP",
 "summary": "If Bluetooth devices (like headphones) disconnect suddenly, TLP might be suspending the USB adapter. Adding the device ID to the denylist prevents this.",
 "aliases": [
  {
   "text": "bluetooth disconnects tlp",
   "lang": "en"
  },
  {
   "text": "hci0 link tx timeout",
   "lang": "en"
  },
  {
   "text": "bluetooth stops working tlp",
   "lang": "en"
  },
  {
   "text": "tlp bluetooth suspend",
   "lang": "en"
  },
  {
   "text": "bluetooth отваливается tlp",
   "lang": "ru"
  },
  {
   "text": "hci0 link tx timeout",
   "lang": "ru"
  },
  {
   "text": "bluetooth не работает tlp",
   "lang": "ru"
  }
 ],
 "error_patterns": [
  "hci0: link tx timeout"
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ],
  "requires": [
   "tlp"
  ]
 },
 "steps": [
  {
   "explain": "Find the Vendor:Product ID of your Bluetooth adapter.",
   "risk": "low"
  },
  {
   "explain": "Edit /etc/tlp.conf and add the ID to USB_DENYLIST, e.g., USB_DENYLIST=\"8087:0aaa\".",
   "risk": "medium",
   "needs_root": true
  },
  {
   "explain": "Restart the TLP service.",
   "risk": "medium",
   "needs_root": true
  },
  {
   "explain": "Restart the Bluetooth service.",
   "risk": "medium",
   "needs_root": true
  }
 ],
 "risk": "medium",
 "rollback": [
  {
   "explain": "Edit /etc/tlp.conf and remove the ID from USB_DENYLIST.",
   "risk": "medium",
   "needs_root": true
  },
  {
   "explain": "Restart the TLP service.",
   "risk": "medium",
   "needs_root": true
  }
 ],
 "warnings": [
  "Excluding the Bluetooth adapter from autosuspend may slightly reduce battery life."
 ],
 "source": {
  "url": "https://wiki.archlinux.org/title/TLP#hci0:_link_tx_timeout",
  "title": "TLP",
  "revision_id": 871782,
  "license": "GFDL-1.3-or-later"
 }
}
