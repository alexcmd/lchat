 "steps": [
  {
   "explain": "Delete journal logs which are older than the specified time (e.g., 2 days).",
   "cmd": "journalctl --vacuum-time <TIME>",
   "risk": "medium",
   "placeholders": [
    {
     "name": "TIME",
     "description": "Time duration (e.g., 2d, 1week, 1month)",
     "example": "2d"
    }
   ]
  }
 ],
