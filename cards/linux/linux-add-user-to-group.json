{
 "schema_version": 2,
 "id": "linux-add-user-to-group",
 "platform": "linux",
 "kind": "task",
 "title": "Add a user to a group",
 "summary": "Add an existing user to an existing group to grant additional permissions.",
 "aliases": [
  {
   "text": "add user to group linux",
   "lang": "en"
  },
  {
   "text": "usermod add group",
   "lang": "en"
  },
  {
   "text": "gpasswd add user",
   "lang": "en"
  },
  {
   "text": "добавить пользователя в группу",
   "lang": "ru"
  },
  {
   "text": "как добавить юзера в группу",
   "lang": "ru"
  },
  {
   "text": "usermod -aG",
   "lang": "en"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Add the user to the specified group. The -a flag appends the user to the group, and -G specifies the group name.",
   "cmd": "sudo usermod -aG <GROUP_NAME> <USERNAME>",
   "needs_root": true,
   "risk": "medium",
   "placeholders": [
    {
     "name": "GROUP_NAME",
     "description": "The name of the group",
     "example": "wheel",
     "discover_cmd": "cat /etc/group"
    },
    {
     "name": "USERNAME",
     "description": "The name of the user",
     "example": "john"
    }
   ],
   "alternatives": [
    {
     "explain": "Alternative command to add a user to a group.",
     "cmd": "sudo gpasswd -a <USERNAME> <GROUP_NAME>",
     "needs_root": true,
     "risk": "medium",
     "placeholders": [
      {
       "name": "USERNAME",
       "description": "The name of the user",
       "example": "john"
      },
      {
       "name": "GROUP_NAME",
       "description": "The name of the group",
       "example": "wheel",
       "discover_cmd": "cat /etc/group"
      }
     ]
    }
   ]
  }
 ],
 "risk": "medium",
 "rollback": [
  {
   "explain": "Remove the user from the group.",
   "cmd": "sudo gpasswd -d <USERNAME> <GROUP_NAME>",
   "needs_root": true,
   "risk": "medium",
   "placeholders": [
    {
     "name": "USERNAME",
     "description": "The name of the user",
     "example": "john"
    },
    {
     "name": "GROUP_NAME",
     "description": "The name of the group",
     "example": "wheel"
    }
   ]
  }
 ],
 "warnings": [
  "The user must log out and log back in for the group membership changes to take effect.",
  "Do not omit the -a flag in usermod, or the user will be removed from all other groups not listed."
 ],
 "source": {
  "url": "https://wiki.archlinux.org/title/Users_and_groups#Group_management",
  "title": "Users and groups",
  "revision_id": 872887,
  "license": "GFDL-1.3-or-later"
 }
}
