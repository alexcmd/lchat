 "steps": [
  {
   "explain": "Edit your crontab.",
   "cmd": "crontab -e",
   "risk": "low"
  },
  {
   "explain": "Prefix your command with 'env DISPLAY=:0'. Replace :0 with your actual display number if different (check with 'echo $DISPLAY'). For example: '0 8 * * * env DISPLAY=:0 /usr/bin/xclock'. Save and exit.",
   "risk": "low"
  }
 ],
