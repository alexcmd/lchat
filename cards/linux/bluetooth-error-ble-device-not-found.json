{
 "schema_version": 2,
 "id": "bluetooth-error-ble-device-not-found",
 "platform": "linux",
 "kind": "error",
 "title": "Fix Bluetooth Low Energy (BLE) device not showing in scan",
 "summary": "Some BLE devices (like Logitech mice) do not appear in standard scans. Use the 'transport le' command in bluetoothctl to scan for them.",
 "error_patterns": [
  "Device not found"
 ],
 "aliases": [
  {
   "text": "ble device not found",
   "lang": "en"
  },
  {
   "text": "logitech mouse not showing bluetooth",
   "lang": "en"
  },
  {
   "text": "bluetooth low energy scan",
   "lang": "en"
  },
  {
   "text": "bluetooth устройство не находится",
   "lang": "ru"
  },
  {
   "text": "не вижу мышь bluetooth",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ]
 },
 "steps": [
  {
   "explain": "Start bluetoothctl.",
   "cmd": "bluetoothctl",
   "risk": "low"
  },
  {
   "explain": "Enter the scan menu.",
   "cmd": "menu scan",
   "risk": "low"
  },
  {
   "explain": "Set transport to Low Energy.",
   "cmd": "transport le",
   "risk": "low"
  },
  {
   "explain": "Go back to the main menu.",
   "cmd": "back",
   "risk": "low"
  },
  {
   "explain": "Start scanning.",
   "cmd": "scan on",
   "risk": "low",
   "expect": "BLE devices appear in the list"
  }
 ],
 "verify": [
  {
   "cmd": "devices",
   "expect": "Device <MAC_ADDRESS> <Device Name>"
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Bluetooth#Pairing_and_connectivity_issues",
