 "steps": [
  {
   "explain": "Copy the directory recursively in verbose mode, preserving permissions, timestamps, and symlinks.",
   "cmd": "cp --verbose --recursive --archive <SOURCE_DIRECTORY> <TARGET_DIRECTORY>",
   "risk": "low",
   "placeholders": [
    {
     "name": "SOURCE_DIRECTORY",
     "description": "Path to the directory you want to copy",
     "example": "my_project"
    },
    {
     "name": "TARGET_DIRECTORY",
     "description": "Path to the destination directory",
     "example": "backups/my_project"
    }
   ],
   "alternatives": [
    {
     "explain": "Use the combined short flags for verbose, recursive, and archive.",
     "cmd": "cp -vra <SOURCE_DIRECTORY> <TARGET_DIRECTORY>",
     "risk": "low",
     "placeholders": [
      {
       "name": "SOURCE_DIRECTORY",
       "description": "Path to the directory you want to copy",
       "example": "my_project"
      },
      {
       "name": "TARGET_DIRECTORY",
       "description": "Path to the destination directory",
       "example": "backups/my_project"
      }
     ]
    }
   ]
  }
 ],
 "risk": "low",
