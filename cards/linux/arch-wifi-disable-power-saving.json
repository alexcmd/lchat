{
 "schema_version": 2,
 "id": "arch-wifi-disable-power-saving",
 "platform": "linux",
 "kind": "task",
 "title": "Disable Wi-Fi power saving to fix disconnections",
 "summary": "Aggressive power saving can cause random Wi-Fi disconnections. Disable it for the interface to improve stability.",
 "aliases": [
  {
   "text": "wifi random disconnections",
   "lang": "en"
  },
  {
   "text": "disable wifi power saving",
   "lang": "en"
  },
  {
   "text": "wifi drops connection",
   "lang": "en"
  },
  {
   "text": "отключить энергосбережение wifi",
   "lang": "ru"
  },
  {
   "text": "wifi отваливается",
   "lang": "ru"
  },
  {
   "text": "iw power save off",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ],
  "requires": [
   "iw"
  ]
 },
 "prerequisites": [
  "Wi-Fi interface is up"
 ],
 "steps": [
  {
   "explain": "Disable power saving for the wireless interface. Replace <INTERFACE> with your interface name.",
   "cmd": "sudo iw dev <INTERFACE> set power_save off",
   "needs_root": true,
   "risk": "low",
   "placeholders": [
    {
     "name": "INTERFACE",
     "description": "Name of the wireless interface",
     "example": "wlan0",
     "discover_cmd": "iw dev"
    }
   ]
  }
 ],
 "verify": [
  {
   "cmd": "iw dev <INTERFACE> link",
   "expect": "Connection remains stable without dropping."
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Network_configuration/Wireless#Random_disconnections",
  "title": "Network configuration/Wireless",
  "revision_id": 886317,
  "license": "GFDL-1.3-or-later"
 }
}
