 "steps": [
  {
   "explain": "Show all messages by a specific process ID.",
   "cmd": "journalctl _PID=<PROCESS_ID>",
   "risk": "low",
   "placeholders": [
    {
     "name": "PROCESS_ID",
     "description": "The PID of the process",
     "example": "1234"
    }
   ],
   "alternatives": [
    {
     "explain": "Show all messages by a specific executable path.",
     "cmd": "journalctl <EXECUTABLE_PATH>",
     "placeholders": [
      {
       "name": "EXECUTABLE_PATH",
       "description": "Full path to the executable",
       "example": "/usr/bin/nginx"
      }
     ]
    }
   ]
  }
 ],
