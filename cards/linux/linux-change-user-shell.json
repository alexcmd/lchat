{
 "schema_version": 2,
 "id": "linux-change-user-shell",
 "platform": "linux",
 "kind": "task",
 "title": "Change a user's login shell",
 "summary": "Change the default shell used when a user logs in.",
 "aliases": [
  {
   "text": "change login shell linux",
   "lang": "en"
  },
  {
   "text": "usermod change shell",
   "lang": "en"
  },
  {
   "text": "chsh command",
   "lang": "en"
  },
  {
   "text": "сменить оболочку пользователя",
   "lang": "ru"
  },
  {
   "text": "как сменить шелл",
   "lang": "ru"
  },
  {
   "text": "изменить bash на zsh",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Change the login shell for the specified user. Replace <SHELL_PATH> with the path to the new shell (e.g., /bin/zsh).",
   "cmd": "sudo usermod -s <SHELL_PATH> <USERNAME>",
   "needs_root": true,
   "risk": "medium",
   "placeholders": [
    {
     "name": "SHELL_PATH",
     "description": "Path to the new login shell",
     "example": "/bin/zsh",
     "discover_cmd": "cat /etc/shells"
    },
    {
     "name": "USERNAME",
     "description": "The name of the user",
     "example": "john"
    }
   ]
  }
 ],
 "risk": "medium",
 "rollback": [
  {
   "explain": "Change the login shell back to the original shell.",
   "cmd": "sudo usermod -s <ORIGINAL_SHELL_PATH> <USERNAME>",
   "needs_root": true,
   "risk": "medium",
   "placeholders": [
    {
     "name": "ORIGINAL_SHELL_PATH",
     "description": "Path to the original login shell",
     "example": "/bin/bash"
    },
    {
     "name": "USERNAME",
     "description": "The name of the user",
     "example": "john"
    }
   ]
  }
 ],
 "warnings": [
  "Ensure the new shell is installed and listed in /etc/shells, otherwise the user will not be able to log in."
 ],
 "source": {
  "url": "https://wiki.archlinux.org/title/Users_and_groups#Other_examples_of_user_management",
