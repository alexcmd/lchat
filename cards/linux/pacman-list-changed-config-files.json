 "id": "pacman-list-changed-config-files",
 "platform": "linux",
 "kind": "task",
 "title": "List modified configuration files",
 "summary": "Find configuration files that have been changed by the user but are tracked by pacman. This is useful for backing up your custom settings.",
 "aliases": [
  {
   "text": "list changed config files arch",
   "lang": "en"
  },
