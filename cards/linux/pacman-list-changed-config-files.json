   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ]
 },
 "steps": [
  {
   "explain": "List all backup files tracked by pacman that have been modified. Run as root to include files like /etc/sudoers.",
   "cmd": "sudo pacman -Qii | awk '/\\[modified\\]/ {print $(NF - 1)}'",
   "needs_root": true,
   "risk": "low"
  }
 ],
 "risk": "low",
