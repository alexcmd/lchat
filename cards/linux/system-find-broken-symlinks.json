 "steps": [
  {
   "explain": "Search the root filesystem for broken symbolic links, excluding virtual filesystems like /proc and /sys.",
   "cmd": "sudo find / -type d \\( -path \"/dev\" -o -path \"/proc\" -o -path \"/run\" -o -path \"/sys\" \\) -prune -o -xtype l -print",
   "needs_root": true,
   "risk": "low"
  }
 ],
