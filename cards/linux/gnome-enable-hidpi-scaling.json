   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "desktop": [
   "gnome"
  ]
 },
 "steps": [
  {
   "explain": "Open GNOME Settings and navigate to the Display configuration.",
   "gui": "Settings > Devices > Displays",
   "risk": "low"
  },
  {
   "explain": "Select the desired scale factor (e.g., 200% or 2x) from the Scale dropdown.",
   "gui": "Select 'Scale' and choose 200% (or 2)",
   "risk": "low"
  },
  {
   "explain": "Alternatively, use the command line to set the scaling factor to 2 (200%).",
   "cmd": "gsettings set org.gnome.desktop.interface scaling-factor 2",
   "risk": "low"
  }
 ],
 "risk": "low",
