 "schema_version": 2,
 "id": "gnome-enable-hidpi-scaling",
 "platform": "linux",
 "kind": "task",
 "title": "Enable HiDPI scaling in GNOME",
 "summary": "Increase the display scale factor in GNOME to make text and UI elements readable on high-resolution screens. This can be done via Settings or command line.",
 "aliases": [
  {
   "text": "gnome hidpi scaling",
   "lang": "en"
  },
