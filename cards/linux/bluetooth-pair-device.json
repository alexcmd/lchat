{
 "schema_version": 2,
 "id": "bluetooth-pair-device",
 "platform": "linux",
 "kind": "task",
 "title": "Pair a Bluetooth device using bluetoothctl",
 "summary": "Use the command-line tool bluetoothctl to scan for, pair with, and connect to a Bluetooth device. This is the standard method for pairing devices on Arch Linux.",
 "aliases": [
  {
   "text": "pair bluetooth device",
   "lang": "en"
  },
  {
   "text": "connect bluetooth headphones",
   "lang": "en"
  },
  {
   "text": "bluetoothctl pair",
   "lang": "en"
  },
  {
   "text": "add bluetooth device",
   "lang": "en"
  },
  {
   "text": "сопряжение bluetooth",
   "lang": "ru"
  },
  {
   "text": "подключить наушники bluetooth",
   "lang": "ru"
  },
  {
   "text": "bluetoothctl как подключить",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ]
 },
 "prerequisites": [
  "Bluetooth service is running",
  "Device is in pairing mode"
 ],
 "steps": [
  {
   "explain": "Start the interactive bluetoothctl shell.",
   "cmd": "bluetoothctl",
   "risk": "low"
  },
  {
   "explain": "Turn on the Bluetooth adapter if it is off.",
   "cmd": "power on",
   "risk": "low"
  },
  {
   "explain": "Start scanning for nearby devices.",
   "cmd": "scan on",
   "risk": "low",
   "expect": "Device XX:XX:XX:XX:XX:XX <Device Name> appears in the list"
  },
  {
   "explain": "Enable the pairing agent to handle PIN codes.",
   "cmd": "agent on",
   "risk": "low"
  },
  {
   "explain": "Set the default agent.",
   "cmd": "default-agent",
   "risk": "low"
  },
  {
   "explain": "Pair with the device using its MAC address.",
   "cmd": "pair <MAC_ADDRESS>",
   "risk": "low",
   "placeholders": [
    {
     "name": "MAC_ADDRESS",
     "description": "The MAC address of the Bluetooth device (e.g., 00:12:34:56:78:90)",
     "example": "00:12:34:56:78:90",
     "discover_cmd": "scan on"
    }
   ],
   "expect": "Pairing successful"
  },
  {
   "explain": "Connect to the paired device.",
   "cmd": "connect <MAC_ADDRESS>",
   "risk": "low",
   "placeholders": [
    {
     "name": "MAC_ADDRESS",
     "description": "The MAC address of the Bluetooth device",
     "example": "00:12:34:56:78:90"
    }
   ],
   "expect": "Connection successful"
  }
 ],
 "verify": [
  {
   "cmd": "devices",
   "expect": "Device <MAC_ADDRESS> <Device Name>"
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Bluetooth#Pairing",
  "title": "Bluetooth",
  "revision_id": 887931,
  "license": "GFDL-1.3-or-later"
 }
}
