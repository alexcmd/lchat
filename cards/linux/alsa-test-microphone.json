{
 "schema_version": 2,
 "id": "alsa-test-microphone",
 "platform": "linux",
 "kind": "task",
 "title": "Test microphone input with arecord",
 "summary": "Record a short audio clip from your microphone and play it back to verify if the input device is working correctly.",
 "aliases": [
  {
   "text": "test microphone linux",
   "lang": "en"
  },
  {
   "text": "arecord test",
   "lang": "en"
  },
  {
   "text": "check if mic works",
   "lang": "en"
  },
  {
   "text": "проверить микрофон linux",
   "lang": "ru"
  },
  {
   "text": "запись звука с микрофона",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Record 5 seconds of audio from the default capture device to a file.",
   "cmd": "arecord --duration=5 --format=dat test-mic.wav",
   "risk": "low"
  },
  {
   "explain": "Play back the recorded file to hear if the microphone captured sound.",
   "cmd": "aplay test-mic.wav",
   "risk": "low"
  }
 ],
 "verify": [
  {
   "cmd": "aplay test-mic.wav",
   "expect": "You hear the sound recorded from the microphone."
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Advanced_Linux_Sound_Architecture/Troubleshooting#Microphone",
