 ],
 "applies_to": {
  "distros": [
   {
    "family": "debian"
   },
   {
    "family": "ubuntu"
   }
  ]
 },
 "steps": [
  {
   "explain": "Remove all packages that are no longer needed.",
   "cmd": "sudo apt-get autoremove",
   "needs_root": true,
   "risk": "medium"
  }
 ],
 "risk": "medium",
 "rollback": [
  {
   "explain": "Reinstall the removed packages if they were needed.",
   "cmd": "sudo apt-get install <PACKAGE>",
   "needs_root": true,
   "risk": "medium",
   "placeholders": [
    {
     "name": "PACKAGE",
     "description": "Name of the package to reinstall",
     "example": "libfoo"
    }
   ]
  }
 ],
 "warnings": [
  "Requires administrator privileges (sudo).",
  "Review the list of packages to be removed before confirming."
 ],
