 "id": "qt5-enable-hidpi-scaling",
 "platform": "linux",
 "kind": "task",
 "title": "Enable HiDPI scaling for Qt5 applications",
 "summary": "Set environment variables to force Qt5 applications to respect screen DPI and scale correctly on HiDPI displays.",
 "aliases": [
  {
   "text": "qt5 hidpi scaling",
   "lang": "en"
  },
