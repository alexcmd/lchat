   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Set the QT_AUTO_SCREEN_SCALE_FACTOR environment variable to 1 to enable automatic scaling.",
   "cmd": "export QT_AUTO_SCREEN_SCALE_FACTOR=1",
   "risk": "low"
  },
  {
   "explain": "Set the QT_ENABLE_HIGHDPI_SCALING environment variable to 1 for newer Qt versions.",
   "cmd": "export QT_ENABLE_HIGHDPI_SCALING=1",
   "risk": "low"
  }
 ],
 "risk": "low",
