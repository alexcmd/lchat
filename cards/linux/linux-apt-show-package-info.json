 "steps": [
  {
   "explain": "Displays detailed metadata about the specified package.",
   "cmd": "apt show <PACKAGE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "PACKAGE",
     "description": "The exact name of the package to inspect.",
     "example": "curl"
    }
   ],
   "alternatives": [
    {
     "explain": "Display metadata and description for the specified package.",
     "cmd": "apt-cache show <PACKAGE>",
     "placeholders": [
      {
       "name": "PACKAGE",
       "description": "Name of the package",
       "example": "vim"
      }
     ],
     "risk": "low"
    },
    {
     "explain": "Use dpkg-query with the status flag and the package name to show its details.",
     "cmd": "dpkg-query -s <PACKAGE>",
     "placeholders": [
      {
       "name": "PACKAGE",
       "description": "The name of the installed package.",
       "example": "libc6"
      }
     ],
     "risk": "low"
    }
   ]
  }
 ],
