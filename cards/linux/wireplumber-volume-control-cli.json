{
 "schema_version": 2,
 "id": "wireplumber-volume-control-cli",
 "platform": "linux",
 "kind": "task",
 "title": "Control volume with wpctl",
 "summary": "Adjust system volume, mute, or unmute using the command line. Useful for scripting or keyboard shortcuts.",
 "aliases": [
  {
   "text": "change volume command line",
   "lang": "en"
  },
  {
   "text": "wpctl set volume",
   "lang": "en"
  },
  {
   "text": "mute audio terminal",
   "lang": "en"
  },
  {
   "text": "keyboard volume control linux",
   "lang": "en"
  },
  {
   "text": "изменить громкость в терминале",
   "lang": "ru"
  },
  {
   "text": "выключить звук командой",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "wireplumber"
  ]
 },
 "steps": [
  {
   "explain": "Raise the volume of the default sink by 5%, up to a limit of 150%.",
   "cmd": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
   "risk": "low",
   "alternatives": [
    {
     "explain": "Lower the volume of the default sink by 5%.",
     "cmd": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    {
     "explain": "Toggle mute for the default sink.",
     "cmd": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    {
     "explain": "Toggle mute for the default source (microphone).",
     "cmd": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    }
   ]
  }
 ],
 "risk": "low",
 "source": {
