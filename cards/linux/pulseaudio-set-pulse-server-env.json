{
 "schema_version": 2,
 "id": "pulseaudio-set-pulse-server-env",
 "platform": "linux",
 "kind": "task",
 "title": "Set PulseAudio server for a command",
 "summary": "Run a command with a specific PulseAudio server by setting the PULSE_SERVER environment variable. Useful for networked audio or testing.",
 "aliases": [
  {
   "text": "set pulse server",
   "lang": "en"
  },
  {
   "text": "pulseaudio remote server",
   "lang": "en"
  },
  {
   "text": "env PULSE_SERVER",
   "lang": "en"
  },
  {
   "text": "connect to remote pulseaudio",
   "lang": "en"
  },
  {
   "text": "подключиться к удаленному pulseaudio",
   "lang": "ru"
  },
  {
   "text": "настроить сервер pulseaudio",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Run a command with the PULSE_SERVER variable set. Replace <SERVER_HOST> with the hostname or IP, and <COMMAND> with the command to run.",
   "cmd": "env PULSE_SERVER=<SERVER_HOST> <COMMAND>",
   "risk": "low",
   "placeholders": [
    {
     "name": "SERVER_HOST",
     "description": "The hostname or IP address of the PulseAudio server.",
     "example": "192.168.1.100"
    },
    {
     "name": "COMMAND",
     "description": "The command to execute.",
     "example": "mplayer test.mp3"
    }
   ]
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/PulseAudio#Selecting_the_server",
