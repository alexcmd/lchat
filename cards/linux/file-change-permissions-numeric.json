 "steps": [
  {
   "explain": "Set permissions using a 3-digit octal number. Each digit represents owner, group, and others. r=4, w=2, x=1.",
   "cmd": "chmod <OCTAL> <FILENAME>",
   "risk": "medium",
   "placeholders": [
    {
     "name": "OCTAL",
     "description": "3-digit octal permission value (e.g., 755 for rwxr-xr-x, 644 for rw-r--r--).",
     "example": "755"
    },
    {
     "name": "FILENAME",
     "description": "Path to the file or directory.",
     "example": "myfile.txt"
    }
   ]
  }
 ],
 "risk": "medium",
 "rollback": [
  {
   "explain": "Restore original permissions if known.",
   "cmd": "chmod <ORIGINAL_OCTAL> <FILENAME>",
   "risk": "medium",
   "placeholders": [
    {
     "name": "ORIGINAL_OCTAL",
     "description": "The original 3-digit octal permission value.",
     "example": "644"
    },
    {
     "name": "FILENAME",
     "description": "Path to the file.",
     "example": "myfile.txt"
    }
   ]
  }
 ],
 "warnings": [
  "Using 777 gives everyone full access and is a security risk.",
  "Verify current permissions with 'stat -c %a <FILENAME>' before changing."
 ],
