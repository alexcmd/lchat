{
 "schema_version": 2,
 "id": "pulseaudio-load-x11-bell-module",
 "platform": "linux",
 "kind": "task",
 "title": "Enable X11 bell handling in PulseAudio",
 "summary": "Load the module that allows PulseAudio to handle X11 bell events. This ensures terminal beeps are routed through PulseAudio.",
 "aliases": [
  {
   "text": "enable x11 bell pulseaudio",
   "lang": "en"
  },
  {
   "text": "load module-x11-bell",
   "lang": "en"
  },
  {
   "text": "pulseaudio x11 bell",
   "lang": "en"
  },
  {
   "text": "включить x11 bell pulseaudio",
   "lang": "ru"
  },
  {
   "text": "загрузить модуль x11 bell",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Upload the bell sample to PulseAudio.",
   "cmd": "pactl upload-sample /usr/share/sounds/freedesktop/stereo/bell.oga bell-window-system",
   "risk": "low"
  },
  {
   "explain": "Load the x11-bell module.",
   "cmd": "pactl load-module module-x11-bell display=$DISPLAY",
   "risk": "low"
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/PulseAudio#X11_Bell_Events",
