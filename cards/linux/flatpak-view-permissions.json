{
 "schema_version": 2,
 "id": "flatpak-view-permissions",
 "platform": "linux",
 "kind": "task",
 "title": "View Flatpak application permissions",
 "summary": "Check what resources and file system paths a Flatpak application is allowed to access.",
 "aliases": [
  {
   "text": "check flatpak permissions",
   "lang": "en"
  },
  {
   "text": "flatpak info permissions",
   "lang": "en"
  },
  {
   "text": "права доступа flatpak",
   "lang": "ru"
  },
  {
   "text": "flatpak permissions",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "flatpak"
  ]
 },
 "steps": [
  {
   "explain": "Show the sandbox permissions for the specified application.",
   "cmd": "flatpak info --show-permissions <APP_ID>",
   "risk": "low",
   "placeholders": [
    {
     "name": "APP_ID",
     "description": "The ID of the application",
     "example": "org.libreoffice.LibreOffice",
     "discover_cmd": "flatpak list"
    }
   ]
  }
 ],
 "risk": "low",
