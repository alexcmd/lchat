 "steps": [
  {
   "explain": "Run the status command to see if the firewall is active and list the current rules.",
   "cmd": "sudo ufw status",
   "needs_root": true,
   "risk": "low",
   "alternatives": [
    {
     "explain": "Show rules with numbers, which is useful if you plan to delete a specific rule by its number.",
     "cmd": "sudo ufw status numbered",
     "needs_root": true,
     "risk": "low"
    },
    {
     "explain": "Show a verbose status, including default policies and listening ports.",
     "cmd": "sudo ufw status verbose",
     "needs_root": true,
     "risk": "low"
    }
   ]
  }
