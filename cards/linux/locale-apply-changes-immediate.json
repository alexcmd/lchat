{
 "schema_version": 2,
 "id": "locale-apply-changes-immediate",
 "platform": "linux",
 "kind": "task",
 "title": "Apply locale changes immediately in current session",
 "summary": "Force the current terminal session to pick up new locale settings without logging out and back in.",
 "aliases": [
  {
   "text": "apply locale changes now",
   "lang": "en"
  },
  {
   "text": "reload locale arch",
   "lang": "en"
  },
  {
   "text": "source locale.sh",
   "lang": "en"
  },
  {
   "text": "unset LANG",
   "lang": "en"
  },
  {
   "text": "применить локаль сразу",
   "lang": "ru"
  },
  {
   "text": "обновить локаль в терминале",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ]
 },
 "steps": [
  {
   "explain": "Unset the current LANG variable so the system can read the new value from configuration files.",
   "risk": "low",
   "cmd": "unset LANG"
  },
  {
   "explain": "Source the locale script to load the new settings from /etc/locale.conf or ~/.config/locale.conf.",
   "risk": "low",
   "cmd": "source /etc/profile.d/locale.sh"
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Locale#Make_locale_changes_immediate",
