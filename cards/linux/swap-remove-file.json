{
 "schema_version": 2,
 "id": "swap-remove-file",
 "platform": "linux",
 "kind": "task",
 "title": "Remove a swap file",
 "summary": "Safely deactivate and delete a swap file, and remove its configuration from fstab.",
 "aliases": [
  {
   "text": "remove swap file",
   "lang": "en"
  },
  {
   "text": "delete swapfile",
   "lang": "en"
  },
  {
   "text": "disable swap file",
   "lang": "en"
  },
  {
   "text": "удалить файл подкачки",
   "lang": "ru"
  },
  {
   "text": "убрать своп файл",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Deactivate the swap file.",
   "cmd": "sudo swapoff /swapfile",
   "needs_root": true,
   "risk": "medium"
  },
  {
   "explain": "Delete the swap file from the disk.",
   "cmd": "sudo rm -f /swapfile",
   "needs_root": true,
   "risk": "medium"
  },
  {
   "explain": "Remove the corresponding entry from /etc/fstab to prevent boot errors.",
   "risk": "medium"
  }
 ],
 "verify": [
  {
   "cmd": "swapon --show",
   "expect": "Output does not list /swapfile."
  }
 ],
 "rollback": [
  {
   "explain": "Recreate the swap file using the 'Create and enable a swap file' procedure.",
   "risk": "medium"
  }
 ],
 "risk": "medium",
 "warnings": [
  "Removing the fstab entry is crucial; otherwise, the system may fail to boot or hang while waiting for the missing file."
 ],
 "source": {
  "url": "https://wiki.archlinux.org/title/Swap#Swap_file_removal",
  "title": "Swap",
  "revision_id": 883810,
  "license": "GFDL-1.3-or-later"
 }
}
