{
 "schema_version": 2,
 "id": "tablet-disable-erratic-mouse",
 "platform": "linux",
 "kind": "task",
 "title": "Disable tablet stylus to fix erratic mouse",
 "summary": "If your mouse jumps due to a proximity sensor detecting a phantom stylus, disable the stylus device using xinput.",
 "aliases": [
  {
   "text": "mouse jumps tablet",
   "lang": "en"
  },
  {
   "text": "disable tablet stylus",
   "lang": "en"
  },
  {
   "text": "xinput disable stylus",
   "lang": "en"
  },
  {
   "text": "мышь прыгает из-за планшета",
   "lang": "ru"
  },
  {
   "text": "отключить стилус",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "display_server": "x11"
 },
 "prerequisites": [
  "Not currently using the stylus"
 ],
 "steps": [
  {
   "explain": "Find the ID of the stylus device.",
   "cmd": "xinput --list",
   "risk": "low"
  },
  {
   "explain": "Disable the stylus device by its ID. Replace <DEVICE_ID> with the number found in the previous step.",
   "cmd": "xinput disable <DEVICE_ID>",
   "risk": "low",
   "placeholders": [
    {
     "name": "DEVICE_ID",
     "description": "Numeric ID of the stylus device",
     "example": "20",
     "discover_cmd": "xinput --list"
    }
   ]
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Graphics_tablet#Mouse_moving_erratically_due_to_proximity_sensor",
  "title": "Graphics tablet",
