 "id": "disk-get-uuid-by-device",
 "platform": "linux",
 "kind": "task",
 "title": "Get UUID or label for a specific device",
 "summary": "Retrieve the UUID or filesystem label for a specific partition (e.g., /dev/sda1) to use in configuration files like fstab.",
 "aliases": [
  {
   "text": "get uuid of sda1",
   "lang": "en"
  },
  {
   "text": "find label of partition",
   "lang": "en"
  },
  {
   "text": "lsblk uuid specific device",
   "lang": "en"
  },
  {
   "text": "blkid get uuid",
   "lang": "en"
  },
  {
   "text": "узнать uuid раздела",
   "lang": "ru"
  },
  {
   "text": "как узнать uuid диска",
   "lang": "ru"
  },
  {
   "text": "lsblk -dno uuid",
   "lang": "ru"
  },
  {
   "text": "blkid -s uuid",
   "lang": "ru"
  },
  {
   "text": "get partition uuid",
   "lang": "en"
  },
  {
   "text": "find uuid of drive",
   "lang": "en"
  },
  {
   "text": "blkid uuid",
   "lang": "en"
  },
  {
   "text": "specific partition uuid",
   "lang": "en"
  },
  {
   "text": "узнать uuid диска",
   "lang": "ru"
  },
  {
   "text": "uuid конкретного раздела",
   "lang": "ru"
  },
  {
   "text": "blkid sda1",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Use lsblk to print only the UUID for the specified device.",
   "cmd": "lsblk -dno UUID /dev/<DEVICE>",
   "placeholders": [
    {
     "name": "DEVICE",
     "description": "The block device path, e.g., sda1 or nvme0n1p2",
     "example": "sda1",
     "discover_cmd": "lsblk"
    }
   ],
   "risk": "low"
  },
  {
   "explain": "Alternatively, use blkid to print only the UUID value for the specified device.",
   "cmd": "sudo blkid -s UUID -o value /dev/<DEVICE>",
   "needs_root": true,
   "placeholders": [
    {
     "name": "DEVICE",
     "description": "The block device path, e.g., sda1 or nvme0n1p2",
     "example": "sda1",
     "discover_cmd": "lsblk"
    }
   ],
   "risk": "low"
  }
 ],
 "risk": "low",
