 "steps": [
  {
   "explain": "Read the link power management policy for all SCSI hosts.",
   "cmd": "grep . /sys/class/scsi_host/host*/link_power_management_policy",
   "risk": "low",
   "expect": "Output like '/sys/class/scsi_host/host0/link_power_management_policy:max_performance'."
  }
 ],
