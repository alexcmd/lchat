{
 "schema_version": 2,
 "id": "flatpak-add-flathub-user",
 "platform": "linux",
 "kind": "task",
 "title": "Add Flathub repository for current user",
 "summary": "Add the official Flathub repository to your user configuration. This allows installing apps without root privileges.",
 "aliases": [
  {
   "text": "add flathub repo",
   "lang": "en"
  },
  {
   "text": "flatpak add remote user",
   "lang": "en"
  },
  {
   "text": "добавить flathub",
   "lang": "ru"
  },
  {
   "text": "flatpak remote add",
   "lang": "ru"
  },
  {
   "text": "add flatpak remote",
   "lang": "en"
  },
  {
   "text": "add flathub to flatpak",
   "lang": "en"
  },
  {
   "text": "добавить репозиторий flatpak",
   "lang": "ru"
  },
  {
   "text": "configure flatpak source",
   "lang": "en"
  },
  {
   "text": "flatpak add remote",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "flatpak"
  ]
 },
 "steps": [
  {
   "explain": "Add the Flathub repository for the current user only.",
   "cmd": "flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo",
   "risk": "low",
   "alternatives": [
    {
     "explain": "Adds a new remote source if it doesn't already exist, allowing you to install apps from it.",
     "cmd": "flatpak remote-add --if-not-exists <REMOTE_NAME> <REMOTE_URL>",
     "placeholders": [
      {
       "name": "REMOTE_NAME",
       "description": "A name for the remote source (e.g., flathub).",
       "example": "flathub"
      },
      {
       "name": "REMOTE_URL",
       "description": "The URL of the remote repository.",
       "example": "https://flathub.org/repo/flathub.flatpakrepo"
      }
     ],
     "risk": "low"
    }
   ]
  }
 ],
 "verify": [
  {
   "cmd": "flatpak remotes",
   "expect": "flathub is listed in the remotes."
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Flatpak#Add_a_repository",
  "title": "Flatpak",
  "revision_id": 886042,
