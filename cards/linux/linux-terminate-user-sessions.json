 "steps": [
  {
   "explain": "Use sudo loginctl terminate-user with the username to end all their active sessions. This requires root privileges.",
   "cmd": "sudo loginctl terminate-user <USERNAME>",
   "risk": "medium",
   "needs_root": true,
   "placeholders": [
    {
     "name": "USERNAME",
     "description": "The username whose sessions should be terminated"
    }
   ]
  }
 ],
 "risk": "medium",
 "rollback": [
  {
   "explain": "There is no direct undo command for terminating sessions. The user must log back in manually.",
   "risk": "low"
  }
 ],
 "warnings": [
  "This action immediately disconnects the user from all their sessions.",
  "Unsaved work in the user's applications may be lost."
 ],
