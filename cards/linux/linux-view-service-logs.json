 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "systemd"
  ]
 },
 "steps": [
  {
   "explain": "Show all log messages for a specific systemd unit (service).",
   "cmd": "journalctl --unit <UNIT>",
   "risk": "low",
   "placeholders": [
    {
     "name": "UNIT",
     "description": "Name of the systemd unit (e.g., nginx.service, sshd.service)",
     "example": "nginx.service"
    }
   ],
   "alternatives": [
    {
     "explain": "Run journalctl with the --unit flag followed by the service name. The .service suffix can be omitted.",
     "cmd": "sudo journalctl --unit <SERVICE_NAME>",
     "needs_root": true,
     "placeholders": [
      {
       "name": "SERVICE_NAME",
       "description": "Name of the systemd unit (e.g., sshd, nginx, bluetooth)",
       "example": "sshd",
       "discover_cmd": "systemctl list-units --type=service"
      }
     ],
     "expect": "The terminal displays only journal entries related to the specified service.",
     "risk": "low"
    }
   ]
  },
  {
   "explain": "Show logs for a unit only since its last start. This is useful for seeing what happened in the current session of the service.",
   "cmd": "journalctl _SYSTEMD_INVOCATION_ID=$(systemctl show --value --property=InvocationID <UNIT>)",
   "risk": "low",
   "placeholders": [
    {
     "name": "UNIT",
     "description": "Name of the systemd unit",
     "example": "nginx.service"
    }
   ]
  }
 ],
 "risk": "low",
