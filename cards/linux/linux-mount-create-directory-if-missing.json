 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Use the --mkdir flag to create the target directory if it does not exist, then mount the device to it.",
   "cmd": "sudo mount --mkdir <DEVICE_FILE> <TARGET_DIRECTORY>",
   "risk": "medium",
   "needs_root": true,
   "placeholders": [
    {
     "name": "DEVICE_FILE",
     "description": "Path to the device file (e.g., /dev/sdb1)",
     "example": "/dev/sdb1",
     "discover_cmd": "lsblk"
    },
    {
     "name": "TARGET_DIRECTORY",
     "description": "Path to the directory to create and mount to",
     "example": "/mnt/new_disk"
    }
   ]
  }
 ],
 "risk": "medium",
 "warnings": [
  "You need administrator privileges to mount devices and create system directories."
 ],
 "rollback": [
  {
   "explain": "Unmount the device.",
   "risk": "medium",
   "needs_root": true
  }
 ],
