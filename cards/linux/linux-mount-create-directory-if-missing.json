 "id": "linux-mount-create-directory-if-missing",
 "platform": "linux",
 "kind": "task",
 "title": "Mount a device and create the mount point if it doesn't exist",
 "summary": "Mount a storage device to a directory, automatically creating the directory if it is missing.",
 "aliases": [
  {
   "text": "mount and create directory",
   "lang": "en"
  },
