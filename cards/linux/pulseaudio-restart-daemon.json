 "id": "pulseaudio-restart-daemon",
 "platform": "linux",
 "kind": "task",
 "title": "Restart PulseAudio daemon",
 "summary": "Kill and restart the PulseAudio server. This is often necessary after changing configuration files or when audio glitches occur.",
 "aliases": [
  {
   "text": "restart pulseaudio",
   "lang": "en"
  },
  {
   "text": "kill pulseaudio",
   "lang": "en"
  },
  {
   "text": "pulseaudio not working",
   "lang": "en"
  },
  {
   "text": "pulseaudio glitch fix",
   "lang": "en"
  },
  {
   "text": "перезапустить pulseaudio",
   "lang": "ru"
  },
  {
   "text": "убить pulseaudio",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Kill the current PulseAudio instance. It will usually restart automatically if autospawn is enabled, or you can start it manually.",
   "cmd": "pulseaudio -k",
   "risk": "low"
  },
  {
   "explain": "Start the PulseAudio daemon again.",
   "cmd": "pulseaudio --start",
   "risk": "low"
  }
 ],
 "risk": "low",
