   "text": "критические ошибки системы",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "systemd"
  ]
 },
 "steps": [
  {
   "explain": "Run journalctl with the priority filter to show only messages with priority 'err' (3) and higher (more critical).",
   "cmd": "sudo journalctl --priority err..alert",
   "needs_root": true,
   "risk": "low",
   "expect": "The terminal displays only error, critical, and alert messages from the journal."
  }
 ],
 "risk": "low",
