{
 "schema_version": 2,
 "id": "ssd-check-firmware-version",
 "platform": "linux",
 "kind": "task",
 "title": "Check SSD firmware version",
 "summary": "Use smartctl to check the current firmware version of your SSD. Updating firmware can resolve bugs and improve performance.",
 "aliases": [
  {
   "text": "check ssd firmware",
   "lang": "en"
  },
  {
   "text": "smartctl firmware version",
   "lang": "en"
  },
  {
   "text": "ssd firmware update check",
   "lang": "en"
  },
  {
   "text": "проверить прошивку ssd",
   "lang": "ru"
  },
  {
   "text": "версия firmware ssd",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "smartmontools"
  ]
 },
 "steps": [
  {
   "explain": "Display information about the SSD, including the firmware version.",
   "cmd": "sudo smartctl -i /dev/<DEVICE>",
   "needs_root": true,
   "risk": "low",
   "placeholders": [
    {
     "name": "DEVICE",
     "description": "The device identifier for the SSD (e.g., sda, nvme0).",
     "example": "sda",
     "discover_cmd": "lsblk"
    }
   ]
  }
 ],
 "risk": "low",
