 "steps": [
  {
   "explain": "Run systemctl list-units with the --all flag to include inactive units in the output.",
   "cmd": "systemctl list-units --all",
   "risk": "low",
   "expect": "A list of all units, including those with 'inactive' or 'dead' state.",
   "alternatives": [
    {
     "explain": "List all units in the system, including inactive and disabled ones.",
     "cmd": "systemctl status --all",
     "expect": "A long list of all units, showing their state (active, inactive, failed, etc.).",
     "risk": "low"
    }
   ]
  }
 ],
