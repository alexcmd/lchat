   "systemd"
  ]
 },
 "steps": [
  {
   "explain": "Run journalctl with the --boot flag to restrict output to the current boot session.",
   "cmd": "sudo journalctl --boot",
   "needs_root": true,
   "risk": "low",
   "expect": "The terminal displays journal entries from the current boot."
  }
 ],
