{
 "schema_version": 2,
 "id": "xorg-adjust-key-repeat-rate",
 "platform": "linux",
 "kind": "task",
 "title": "Adjust keyboard repeat delay and rate",
 "summary": "Change how fast a key repeats when held down in Xorg. Useful if typing feels too slow or too fast.",
 "aliases": [
  {
   "text": "change key repeat rate linux",
   "lang": "en"
  },
  {
   "text": "xset r rate",
   "lang": "en"
  },
  {
   "text": "keyboard repeat speed xorg",
   "lang": "en"
  },
  {
   "text": "скорость повторения клавиш",
   "lang": "ru"
  },
  {
   "text": "задержка повторения клавиш",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "display_server": "x11"
 },
 "steps": [
  {
   "explain": "Set the typematic delay (ms) and rate (Hz). Replace <DELAY> and <RATE> with your desired values (e.g., 200 and 30).",
   "cmd": "xset r rate <DELAY> <RATE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "DELAY",
     "description": "Delay in milliseconds before repeat starts",
     "example": "200"
    },
    {
     "name": "RATE",
     "description": "Repeat rate in Hz",
     "example": "30"
    }
   ]
  }
 ],
 "risk": "low",
 "source": {
