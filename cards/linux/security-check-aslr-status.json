{
 "schema_version": 2,
 "id": "security-check-aslr-status",
 "platform": "linux",
 "kind": "task",
 "title": "Check Address Space Layout Randomization (ASLR) status",
 "summary": "Verify that ASLR is enabled and set to its maximum security level. ASLR makes it harder for attackers to predict memory addresses for exploits.",
 "aliases": [
  {
   "text": "check aslr status",
   "lang": "en"
  },
  {
   "text": "randomize_va_space check",
   "lang": "en"
  },
  {
   "text": "memory security check",
   "lang": "en"
  },
  {
   "text": "проверить aslr",
   "lang": "ru"
  },
  {
   "text": "kernel randomization status",
   "lang": "en"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Read the current ASLR configuration. A value of '2' indicates full randomization (heap, stack, and mmap).",
   "cmd": "cat /proc/sys/kernel/randomize_va_space",
   "risk": "low",
   "expect": "2"
  }
 ],
 "risk": "low",
