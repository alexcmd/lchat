{
 "schema_version": 2,
 "id": "eth-fix-broadcom-module-order",
 "platform": "linux",
 "kind": "task",
 "title": "Fix Broadcom Ethernet module loading order",
 "summary": "Reload Broadcom network modules in the correct order if the interface is not working.",
 "aliases": [
  {
   "text": "broadcom ethernet not working",
   "lang": "en"
  },
  {
   "text": "tg3 module error",
   "lang": "en"
  },
  {
   "text": "bcm57780 fix",
   "lang": "en"
  },
  {
   "text": "broadcom сеть не работает",
   "lang": "ru"
  },
  {
   "text": "tg3 broadcom",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Unload the tg3 module.",
   "cmd": "sudo modprobe -r tg3",
   "needs_root": true,
   "risk": "medium"
  },
  {
   "explain": "Load the broadcom module first.",
   "cmd": "sudo modprobe broadcom",
   "needs_root": true,
   "risk": "medium"
  },
  {
   "explain": "Load the tg3 module second.",
   "cmd": "sudo modprobe tg3",
   "needs_root": true,
   "risk": "medium"
  },
  {
   "explain": "Verify the driver loaded successfully.",
   "cmd": "sudo dmesg | grep tg3",
   "needs_root": true,
   "risk": "low",
   "expect": "Log lines showing tg3 initialization."
  }
 ],
 "risk": "medium",
 "rollback": [
  {
   "explain": "Reboot to reset module states.",
   "cmd": "sudo reboot",
   "needs_root": true,
   "risk": "medium"
  }
 ],
 "warnings": [
  "This is a temporary fix. To make it permanent, create /etc/modprobe.d/broadcom.conf with 'softdep tg3 pre: broadcom'."
 ],
 "source": {
  "url": "https://wiki.archlinux.org/title/Network_configuration/Ethernet#Broadcom_BCM57780",
  "title": "Network configuration/Ethernet",
