 ],
 "steps": [
  {
   "explain": "List all files provided by the specified package.",
   "cmd": "pkgfile --list <PACKAGE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "PACKAGE",
     "description": "The name of the package.",
     "example": "coreutils"
    }
   ],
   "alternatives": [
    {
     "explain": "List only the executables (binaries) provided by the package.",
     "cmd": "pkgfile --list --binaries <PACKAGE>",
     "placeholders": [
      {
       "name": "PACKAGE",
       "description": "The name of the package.",
       "example": "coreutils"
      }
     ]
    }
   ]
  }
 ],
