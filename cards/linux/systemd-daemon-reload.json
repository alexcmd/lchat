 "steps": [
  {
   "explain": "Reload the systemd manager configuration to pick up changes in unit files.",
   "cmd": "sudo systemctl daemon-reload",
   "needs_root": true,
   "risk": "medium",
   "expect": "No output if successful."
  }
 ],
 "risk": "medium",
 "rollback": [
  {
   "explain": "There is no direct rollback for daemon-reload. If a new unit file is broken, remove or fix the file and run daemon-reload again.",
   "cmd": "sudo systemctl daemon-reload",
   "needs_root": true,
   "risk": "medium"
  }
 ],
 "warnings": [
  "This does not restart services. You must restart the specific service for configuration changes to take effect."
 ],
