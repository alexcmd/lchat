    },
    {
     "name": "PROTOCOL",
     "description": "The protocol (e.g., tcp or udp).",
     "example": "tcp"
    },
    {
     "name": "NAME",
     "description": "The domain name for the service.",
     "example": "gmail.com"
    }
   ]
  }
 ],
