   "explain": "Use lsusb with the -d flag to show only devices matching the specified vendor and product ID. Replace <VENDOR> and <PRODUCT> with the hexadecimal IDs.",
   "cmd": "lsusb -d <VENDOR>:<PRODUCT>",
   "risk": "low",
   "placeholders": [
    {
     "name": "VENDOR",
     "description": "The vendor ID (hexadecimal)",
     "example": "046d",
     "discover_cmd": "lsusb"
    },
    {
     "name": "PRODUCT",
     "description": "The product ID (hexadecimal)",
     "example": "c52b",
     "discover_cmd": "lsusb"
    }
   ],
   "expect": "Only the USB device(s) matching the given vendor and product ID are listed."
  }
 ],
