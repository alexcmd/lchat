{
 "schema_version": 2,
 "id": "alsa-restore-volume-after-reboot",
 "platform": "linux",
 "kind": "task",
 "title": "Restore ALSA volume settings after reboot",
 "summary": "If your sound is muted or volume is wrong after restarting, this command restores the last saved ALSA mixer state.",
 "aliases": [
  {
   "text": "sound muted after reboot",
   "lang": "en"
  },
  {
   "text": "alsa restore volume",
   "lang": "en"
  },
  {
   "text": "no sound after restart",
   "lang": "en"
  },
  {
   "text": "звук пропал после перезагрузки",
   "lang": "ru"
  },
  {
   "text": "восстановить громкость alsa",
   "lang": "ru"
  },
  {
   "text": "alsactl restore",
   "lang": "en"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "prerequisites": [
  "ALSA is the active sound system (not just PulseAudio/PipeWire)"
 ],
 "steps": [
  {
   "explain": "Run alsactl to restore the mixer settings saved in the previous session.",
   "cmd": "sudo alsactl restore",
   "needs_root": true,
   "risk": "low"
  }
 ],
 "risk": "low",
