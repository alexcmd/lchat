{
 "schema_version": 2,
 "id": "pacman-list-recently-installed",
 "platform": "linux",
 "kind": "task",
 "title": "List recently installed packages",
 "summary": "Show the last 20 packages installed on your system, sorted by installation date. This helps track recent changes.",
 "aliases": [
  {
   "text": "list recent packages arch",
   "lang": "en"
  },
  {
   "text": "pacman install history",
   "lang": "en"
  },
  {
   "text": "what did I install recently",
   "lang": "en"
  },
  {
   "text": "last installed packages",
   "lang": "en"
  },
  {
   "text": "список недавно установленных пакетов arch",
   "lang": "ru"
  },
  {
   "text": "история установки pacman",
   "lang": "ru"
  },
  {
   "text": "что я установил недавно",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ],
  "requires": [
   "expac"
  ]
 },
 "steps": [
  {
   "explain": "List the 20 most recently installed packages with their installation timestamps.",
   "cmd": "expac --timefmt='%Y-%m-%d %T' '%l\\t%n' | sort | tail -n 20",
   "risk": "low"
  }
 ],
 "risk": "low",
