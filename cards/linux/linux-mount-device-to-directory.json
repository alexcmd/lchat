 "steps": [
  {
   "explain": "Mount the specified device file to the target directory. The directory must already exist.",
   "cmd": "sudo mount <DEVICE_FILE> <TARGET_DIRECTORY>",
   "risk": "medium",
   "needs_root": true,
   "placeholders": [
    {
     "name": "DEVICE_FILE",
     "description": "Path to the device file (e.g., /dev/sdb1)",
     "example": "/dev/sdb1",
     "discover_cmd": "lsblk"
    },
    {
     "name": "TARGET_DIRECTORY",
     "description": "Path to the existing directory where the device will be mounted",
     "example": "/mnt/usb"
    }
   ]
  }
 ],
 "risk": "medium",
 "warnings": [
  "Ensure the target directory is empty or you intend to hide its current contents.",
  "You need administrator privileges to mount devices."
 ],
 "rollback": [
  {
   "explain": "Unmount the device to safely disconnect it.",
   "risk": "medium",
   "needs_root": true
  }
 ],
