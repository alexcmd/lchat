{
 "schema_version": 2,
 "id": "xrandr-arrange-monitors",
 "platform": "linux",
 "kind": "task",
 "title": "Arrange multiple monitors with xrandr",
 "summary": "Use xrandr to position your monitors relative to each other (e.g., one to the right of the other) or set specific resolutions. This changes the layout for the current session.",
 "aliases": [
  {
   "text": "setup dual monitors linux",
   "lang": "en"
  },
  {
   "text": "xrandr right of",
   "lang": "en"
  },
  {
   "text": "arrange screens linux",
   "lang": "en"
  },
  {
   "text": "настроить два монитора",
   "lang": "ru"
  },
  {
   "text": "xrandr расположение мониторов",
   "lang": "ru"
  },
  {
   "text": "как поставить монитор справа",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "display_server": "x11",
  "requires": [
   "xrandr"
  ]
 },
 "prerequisites": [
  "You know the names of your outputs (e.g., HDMI-1, DP-1) from 'xrandr -q'."
 ],
 "steps": [
  {
   "explain": "List connected monitors to identify their names (e.g., HDMI1, VGA1).",
   "cmd": "xrandr -q",
   "risk": "low",
   "expect": "A list of connected outputs and their statuses."
  },
  {
   "explain": "Set the layout. This example places HDMI1 to the right of VGA1, using their preferred resolutions.",
   "cmd": "xrandr --output <MON_LEFT> --auto --output <MON_RIGHT> --auto --right-of <MON_LEFT>",
   "risk": "low",
   "placeholders": [
    {
     "name": "MON_LEFT",
     "description": "Name of the left/primary monitor",
     "example": "HDMI-1",
     "discover_cmd": "xrandr -q"
    },
    {
     "name": "MON_RIGHT",
     "description": "Name of the right/secondary monitor",
     "example": "DP-1",
     "discover_cmd": "xrandr -q"
    }
   ]
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Multihead#Configuration_using_xrandr",
  "title": "Multihead",
