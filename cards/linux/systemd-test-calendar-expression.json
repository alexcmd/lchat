 "schema_version": 2,
 "id": "systemd-test-calendar-expression",
 "platform": "linux",
 "kind": "task",
 "title": "Test systemd calendar time expression",
 "summary": "Verify if a systemd OnCalendar time expression is valid and see when it would next trigger.",
 "aliases": [
  {
   "text": "test systemd calendar",
   "lang": "en"
  },
  {
   "text": "check oncalendar syntax",
   "lang": "en"
  },
  {
   "text": "systemd analyze calendar",
   "lang": "en"
  },
  {
   "text": "validate systemd timer time",
   "lang": "en"
  },
  {
   "text": "test systemd calendar",
   "lang": "ru"
  },
  {
   "text": "check oncalendar syntax",
   "lang": "ru"
  },
  {
   "text": "systemd analyze calendar",
   "lang": "ru"
  },
  {
   "text": "validate systemd timer time",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "systemd"
  ]
 },
 "steps": [
  {
   "explain": "Analyze a calendar expression to check its validity and next execution time.",
   "cmd": "systemd-analyze calendar <CALENDAR_EXPRESSION>",
   "risk": "low",
   "placeholders": [
    {
     "name": "CALENDAR_EXPRESSION",
     "description": "The systemd OnCalendar expression to test, e.g., 'weekly' or '*-*-* 02:00:00'",
     "example": "weekly"
    }
   ]
  }
 ],
 "verify": [
  {
   "cmd": "systemd-analyze calendar weekly",
   "expect": "Output showing 'Valid: yes' and the next scheduled time."
  }
 ],
 "risk": "low",
