   "lang": "en"
  },
  {
   "text": "turn on monitor power saving",
   "lang": "en"
  },
  {
   "text": "allow monitor sleep",
   "lang": "en"
  },
  {
   "text": "xset dpms on",
   "lang": "en"
  },
  {
   "text": "включить dpms",
   "lang": "ru"
  },
  {
   "text": "включить энергосбережение монитора",
   "lang": "ru"
  },
  {
   "text": "монитор засыпает",
   "lang": "ru"
  },
  {
   "text": "xset +dpms",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
