 "id": "linux-enable-dpms",
 "platform": "linux",
 "kind": "task",
 "title": "Enable DPMS power saving",
 "summary": "Turn on DPMS (Display Power Management Signaling) features. This allows the monitor to enter power-saving modes when idle.",
 "aliases": [
