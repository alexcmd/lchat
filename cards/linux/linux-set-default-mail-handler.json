 "steps": [
  {
   "explain": "Set the application that handles mailto: links. Replace the placeholder with the .desktop file of your preferred email client.",
   "cmd": "xdg-settings set default-url-scheme-handler mailto <DESKTOP_FILE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "DESKTOP_FILE",
     "description": "The .desktop file name of the email client (e.g., evolution.desktop, thunderbird.desktop).",
     "example": "evolution.desktop",
     "discover_cmd": "ls /usr/share/applications/*.desktop"
    }
   ]
  }
 ],
 "risk": "low",
