 "title": "Use SOCKS proxy with curl and pacman",
 "summary": "Set the all_proxy environment variable to make curl and pacman use a SOCKS5 proxy.",
 "aliases": [
  {
   "text": "curl socks proxy",
   "lang": "en"
  },
  {
   "text": "pacman socks proxy",
   "lang": "en"
  },
  {
   "text": "all_proxy socks5",
   "lang": "en"
  },
  {
   "text": "curl socks5",
   "lang": "ru"
  },
  {
   "text": "pacman через socks",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "prerequisites": [
  "A running SOCKS5 proxy."
 ],
 "steps": [
  {
   "explain": "Set the all_proxy variable to your SOCKS5 proxy address. Replace <PROXY_ADDRESS> with your proxy IP and port.",
   "cmd": "export all_proxy=\"socks5://<PROXY_ADDRESS>\"",
   "risk": "low",
   "placeholders": [
    {
     "name": "PROXY_ADDRESS",
     "description": "The IP address and port of the SOCKS5 proxy.",
     "example": "127.0.0.1:1080"
    }
   ]
  }
 ],
 "risk": "low",
