{
 "schema_version": 2,
 "id": "arch-install-reboot",
 "platform": "linux",
 "kind": "task",
 "title": "Reboot after Arch Linux installation",
 "summary": "Exit the chroot environment, unmount partitions, and reboot the system to boot into the new installation.",
 "aliases": [
  {
   "text": "reboot arch install",
   "lang": "en"
  },
  {
   "text": "finish arch install",
   "lang": "en"
  },
  {
   "text": "exit chroot arch",
   "lang": "en"
  },
  {
   "text": "перезагрузить после установки arch",
   "lang": "ru"
  },
  {
   "text": "выйти из chroot arch",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ]
 },
 "prerequisites": [
  "Boot loader installed"
 ],
 "steps": [
  {
   "explain": "Exit the chroot environment.",
   "cmd": "exit",
   "needs_root": false,
   "risk": "low",
   "expect": "Return to the live environment shell."
  },
  {
   "explain": "Unmount all mounted partitions.",
   "cmd": "sudo umount -R /mnt",
   "needs_root": true,
   "risk": "medium",
   "expect": "No output if successful."
  },
  {
   "explain": "Reboot the system.",
   "cmd": "sudo reboot",
   "needs_root": true,
   "risk": "medium",
   "expect": "System restarts."
  }
 ],
 "risk": "medium",
 "warnings": [
  "Remove the installation medium (USB/DVD) before the system boots to ensure it boots from the hard drive."
 ],
 "rollback": [
  {
   "explain": "Boot from live media again.",
   "cmd": "",
   "risk": "low"
  }
 ],
 "source": {
  "url": "https://wiki.archlinux.org/title/Installation_guide#Reboot",
  "title": "Installation guide",
  "revision_id": 886382,
  "license": "GFDL-1.3-or-later"
 }
}
