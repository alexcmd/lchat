{
 "schema_version": 2,
 "id": "security-unlock-user-faillock",
 "platform": "linux",
 "kind": "task",
 "title": "Unlock a user account locked by pam_faillock",
 "summary": "If a user is locked out after too many failed login attempts, this command resets the lockout counter, allowing them to try again.",
 "aliases": [
  {
   "text": "unlock user faillock",
   "lang": "en"
  },
  {
   "text": "account locked after failed attempts",
   "lang": "en"
  },
  {
   "text": "reset login lockout",
   "lang": "en"
  },
  {
   "text": "разблокировать пользователя",
   "lang": "ru"
  },
  {
   "text": "pam_faillock reset",
   "lang": "en"
  },
  {
   "text": "too many failed logins",
   "lang": "en"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ]
 },
 "prerequisites": [
  "pam_faillock is enabled (default in recent Arch installs)"
 ],
 "steps": [
  {
   "explain": "Reset the failed login counter for a specific user.",
   "cmd": "faillock --user <USERNAME> --reset",
   "placeholders": [
    {
     "name": "USERNAME",
     "description": "The username to unlock",
     "example": "john",
     "discover_cmd": "ls /run/faillock/"
    }
   ],
   "risk": "low"
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Security#Lock_out_user_after_three_failed_login_attempts",
  "title": "Security",
  "revision_id": 888599,
  "license": "GFDL-1.3-or-later"
 }
}
