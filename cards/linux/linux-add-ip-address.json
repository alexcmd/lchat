 "steps": [
  {
   "explain": "Add an IP address to a specified network interface. Requires root privileges.",
   "cmd": "sudo ip address add <IP_ADDRESS> dev <INTERFACE>",
   "risk": "medium",
   "needs_root": true,
   "placeholders": [
    {
     "name": "IP_ADDRESS",
     "description": "The IP address to add (e.g., 192.168.1.10/24).",
     "example": "192.168.1.10/24"
    },
    {
     "name": "INTERFACE",
     "description": "The network interface name (e.g., eth0).",
     "example": "eth0",
     "discover_cmd": "ip address"
    }
   ],
   "alternatives": [
    {
     "explain": "Use `sudo ip address add` or `delete` with the IP address, subnet mask, and interface name.",
     "cmd": "sudo ip address <ACTION> <IP_ADDRESS>/<MASK> dev <INTERFACE>",
     "needs_root": true,
     "placeholders": [
      {
       "name": "ACTION",
       "description": "The action to perform: 'add' or 'delete'.",
       "example": "add"
      },
      {
       "name": "IP_ADDRESS",
       "description": "The IP address to add or remove.",
       "example": "192.168.1.100"
      },
      {
       "name": "MASK",
       "description": "The subnet mask in CIDR notation (e.g., 24 for 255.255.255.0).",
       "example": "24"
      },
      {
       "name": "INTERFACE",
       "description": "The network interface name.",
       "example": "eth0",
       "discover_cmd": "ip link"
      }
     ],
     "risk": "medium"
    }
   ]
  }
 ],
 "risk": "medium",
 "rollback": [
  {
   "explain": "Remove the IP address you just added to revert the change.",
   "cmd": "sudo ip address delete <IP_ADDRESS> dev <INTERFACE>",
   "risk": "medium",
   "needs_root": true,
   "placeholders": [
    {
     "name": "IP_ADDRESS",
     "description": "The IP address to remove.",
     "example": "192.168.1.10/24"
    },
    {
     "name": "INTERFACE",
     "description": "The network interface name.",
     "example": "eth0"
    }
   ]
  }
 ],
