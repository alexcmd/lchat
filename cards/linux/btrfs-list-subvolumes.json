{
 "schema_version": 2,
 "id": "btrfs-list-subvolumes",
 "platform": "linux",
 "kind": "task",
 "title": "List Btrfs subvolumes",
 "summary": "Display a list of all subvolumes within a mounted Btrfs file system.",
 "aliases": [
  {
   "text": "list btrfs subvolumes",
   "lang": "en"
  },
  {
   "text": "show btrfs subvols",
   "lang": "en"
  },
  {
   "text": "btrfs subvolume list",
   "lang": "en"
  },
  {
   "text": "список подтомов btrfs",
   "lang": "ru"
  },
  {
   "text": "посмотреть подтома",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ]
 },
 "steps": [
  {
   "explain": "List all subvolumes for the file system containing the specified path. Replace <PATH> with a path on the Btrfs mount (e.g., /).",
   "cmd": "sudo btrfs subvolume list -t <PATH>",
   "needs_root": true,
   "risk": "low",
   "placeholders": [
    {
     "name": "PATH",
     "description": "Path to a directory on the Btrfs file system",
     "example": "/",
     "discover_cmd": "lsblk -f"
    }
   ]
  }
 ],
 "risk": "low",
