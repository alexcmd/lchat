 "steps": [
  {
   "explain": "Set the brightness for a specific output. Replace <OUTPUT> with your monitor name and <BRIGHTNESS> with a value between 0.0 and 1.0 (e.g., 0.5 for 50%).",
   "cmd": "xrandr --output <OUTPUT> --brightness <BRIGHTNESS>",
   "risk": "low",
   "placeholders": [
    {
     "name": "OUTPUT",
     "description": "Name of the display output (e.g., LVDS1)",
     "discover_cmd": "xrandr --query"
    },
    {
     "name": "BRIGHTNESS",
     "description": "Brightness level from 0.0 to 1.0",
     "example": "0.5"
    }
   ]
  }
 ],
 "risk": "low",
