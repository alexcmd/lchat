   "xrandr"
  ]
 },
 "steps": [
  {
   "explain": "Set the resolution and refresh rate for a specific display output. Replace <OUTPUT> with your monitor's name (e.g., HDMI1, DP1) and <RESOLUTION> with the desired size (e.g., 1920x1080).",
   "cmd": "xrandr --output <OUTPUT> --mode <RESOLUTION> --rate <RATE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "OUTPUT",
     "description": "Name of the display output (e.g., HDMI1, DP1, VGA1)",
     "discover_cmd": "xrandr --query"
    },
    {
     "name": "RESOLUTION",
     "description": "Desired resolution (e.g., 1920x1080)",
     "discover_cmd": "xrandr --query"
    },
    {
     "name": "RATE",
     "description": "Refresh rate in Hz (e.g., 60)",
     "discover_cmd": "xrandr --query"
    }
   ],
   "alternatives": [
    {
     "explain": "Short form for the rate flag.",
     "cmd": "xrandr --output <OUTPUT> --mode <RESOLUTION> -r <RATE>",
     "risk": "low",
     "placeholders": [
      {
       "name": "OUTPUT",
       "description": "Name of the display output",
       "discover_cmd": "xrandr --query"
      },
      {
       "name": "RESOLUTION",
       "description": "Desired resolution",
       "discover_cmd": "xrandr --query"
      },
      {
       "name": "RATE",
       "description": "Refresh rate in Hz",
       "discover_cmd": "xrandr --query"
      }
     ]
    }
   ]
  }
 ],
