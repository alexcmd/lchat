 "id": "linux-xrandr-set-resolution",
 "platform": "linux",
 "kind": "task",
 "title": "Set screen resolution and refresh rate",
 "summary": "Change the resolution and refresh rate for a specific monitor output. You need to know the output name (like HDMI1 or DP1) and a supported resolution.",
 "aliases": [
  {
   "text": "change resolution linux",
   "lang": "en"
  },
