 "steps": [
  {
   "explain": "Show the latest log entries. By default, it shows all messages. You can limit the number of lines or follow new messages in real-time.",
   "cmd": "journalctl",
   "risk": "low",
   "alternatives": [
    {
     "explain": "Show the last N lines of the log.",
     "cmd": "journalctl --lines <NUMBER_OF_LINES>",
     "placeholders": [
      {
       "name": "NUMBER_OF_LINES",
       "description": "Number of lines to show",
       "example": "50"
      }
     ]
    },
    {
     "explain": "Show the last N lines and keep printing new messages as they arrive (like tail -f).",
     "cmd": "journalctl --lines <NUMBER_OF_LINES> --follow",
     "placeholders": [
      {
       "name": "NUMBER_OF_LINES",
       "description": "Number of lines to show initially",
       "example": "20"
      }
     ]
    },
    {
     "explain": "Show messages from a specific time range (e.g., since yesterday).",
     "cmd": "journalctl --since <START_TIME> --until <END_TIME>",
     "placeholders": [
      {
       "name": "START_TIME",
       "description": "Start time (e.g., 'yesterday', 'today', '2 hours ago')",
       "example": "yesterday"
      },
      {
       "name": "END_TIME",
       "description": "End time (e.g., 'now', '2023-10-27 12:00:00')",
       "example": "now"
      }
     ]
    }
   ]
  }
 ],
 "risk": "low",
