{
 "schema_version": 2,
 "id": "console-load-keymap-temp",
 "platform": "linux",
 "kind": "task",
 "title": "Load console keyboard layout temporarily",
 "summary": "Change the keyboard layout for the current text console session only. This is useful for testing layouts without affecting the system configuration.",
 "aliases": [
  {
   "text": "loadkeys",
   "lang": "en"
  },
  {
   "text": "temporary keyboard layout",
   "lang": "en"
  },
  {
   "text": "test keymap",
   "lang": "en"
  },
  {
   "text": "загрузить раскладку клавиатуры",
   "lang": "ru"
  },
  {
   "text": "временно сменить раскладку",
   "lang": "ru"
  },
  {
   "text": "loadkeys us",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "kbd"
  ]
 },
 "steps": [
  {
   "explain": "Load a specific keymap for the current session. Replace <KEYMAP> with the desired layout code (e.g., us, de, ru).",
   "cmd": "sudo loadkeys <KEYMAP>",
   "needs_root": true,
   "risk": "low",
   "placeholders": [
    {
     "name": "KEYMAP",
     "description": "The keymap code (e.g., us, de, ru)",
     "example": "us",
     "discover_cmd": "localectl list-keymaps"
    }
   ]
  }
 ],
 "verify": [
  {
   "cmd": "localectl status",
   "expect": "VC Keymap: <KEYMAP>"
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Linux_console/Keyboard_configuration#Loadkeys",
  "title": "Linux console/Keyboard configuration",
  "revision_id": 888113,
  "license": "GFDL-1.3-or-later"
 }
}
