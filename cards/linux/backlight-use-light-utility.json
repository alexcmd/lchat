 "steps": [
  {
   "explain": "Increase brightness by 5 percent.",
   "cmd": "light -A 5",
   "risk": "low",
   "expect": "Screen brightness increases."
  },
  {
   "explain": "Decrease brightness by 5 percent.",
   "cmd": "light -U 5",
   "risk": "low",
   "expect": "Screen brightness decreases."
  },
  {
   "explain": "Set brightness to a specific percentage (e.g., 100%).",
   "cmd": "light -S 100",
   "risk": "low",
   "expect": "Screen brightness is set to the specified level."
  }
 ],
