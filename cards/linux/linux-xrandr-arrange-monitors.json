 "steps": [
  {
   "explain": "Set the resolution for a secondary monitor and place it to the right of a primary monitor. Replace <OUTPUT_SECONDARY> and <OUTPUT_PRIMARY> with your actual output names.",
   "cmd": "xrandr --output <OUTPUT_SECONDARY> --mode <RESOLUTION> --right-of <OUTPUT_PRIMARY>",
   "risk": "low",
   "placeholders": [
    {
     "name": "OUTPUT_SECONDARY",
     "description": "Name of the monitor to position (e.g., HDMI2)",
     "discover_cmd": "xrandr --query"
    },
    {
     "name": "RESOLUTION",
     "description": "Resolution for the secondary monitor (e.g., 1280x1024)",
     "discover_cmd": "xrandr --query"
    },
    {
     "name": "OUTPUT_PRIMARY",
     "description": "Name of the monitor to position relative to (e.g., DP1)",
     "discover_cmd": "xrandr --query"
    }
   ]
  }
 ],
