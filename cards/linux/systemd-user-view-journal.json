{
 "schema_version": 2,
 "id": "systemd-user-view-journal",
 "platform": "linux",
 "kind": "task",
 "title": "View logs for systemd user services",
 "summary": "Check the logs generated by your personal systemd user services. This helps in debugging why a user daemon might not be starting or behaving correctly.",
 "aliases": [
  {
   "text": "view systemd user logs",
   "lang": "en"
  },
  {
   "text": "journalctl --user",
   "lang": "en"
  },
  {
   "text": "check user service logs",
   "lang": "en"
  },
  {
   "text": "systemd user journal",
   "lang": "en"
  },
  {
   "text": "логи systemd user",
   "lang": "ru"
  },
  {
   "text": "journalctl user",
   "lang": "ru"
  },
  {
   "text": "посмотреть лог сервиса пользователя",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "systemd"
  ]
 },
 "steps": [
  {
   "explain": "View the journal for all user services.",
   "cmd": "journalctl --user",
   "risk": "low"
  },
  {
   "explain": "Alternatively, view logs for a specific user unit.",
   "cmd": "journalctl --user-unit <UNIT_NAME>",
   "risk": "low",
   "placeholders": [
    {
     "name": "UNIT_NAME",
     "description": "Name of the systemd user unit",
     "example": "mpd.service"
    }
   ]
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Systemd/User#Reading_the_journal",
  "title": "Systemd/User",
  "revision_id": 885754,
  "license": "GFDL-1.3-or-later"
 }
}
