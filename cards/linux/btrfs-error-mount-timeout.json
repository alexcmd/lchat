{
 "schema_version": 2,
 "id": "btrfs-error-mount-timeout",
 "platform": "linux",
 "kind": "error",
 "title": "Fix Btrfs mounting timed out error",
 "summary": "Resolve boot failures where Btrfs mounting times out, often seen with large RAID arrays.",
 "aliases": [
  {
   "text": "btrfs mount timeout",
   "lang": "en"
  },
  {
   "text": "mounting timed out btrfs",
   "lang": "en"
  },
  {
   "text": "systemd mount timeout btrfs",
   "lang": "en"
  },
  {
   "text": "таймаут монтирования btrfs",
   "lang": "ru"
  },
  {
   "text": "btrfs не успевает смонтироваться",
   "lang": "ru"
  }
 ],
 "error_patterns": [
  "Mounting timed out. Terminating.",
  "Failed to mount /data."
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ]
 },
 "steps": [
  {
   "explain": "Edit /etc/fstab and add the x-systemd.mount-timeout option to the Btrfs mount line. For example, add 'x-systemd.mount-timeout=5min' to the mount options.",
   "risk": "medium"
  }
 ],
 "risk": "medium",
 "warnings": [
  "Incorrect fstab entries can prevent the system from booting.",
  "Verify the syntax carefully."
 ],
 "rollback": [
  {
   "explain": "Remove the x-systemd.mount-timeout option from /etc/fstab.",
   "risk": "medium"
  }
 ],
 "source": {
