{
 "schema_version": 2,
 "id": "console-adjust-key-repeat-rate",
 "platform": "linux",
 "kind": "task",
 "title": "Adjust console keyboard repeat rate",
 "summary": "Change how fast keys repeat when held down in the text console. This affects the delay before repeating starts and the speed of repetition.",
 "aliases": [
  {
   "text": "change key repeat rate",
   "lang": "en"
  },
  {
   "text": "kbdrate",
   "lang": "en"
  },
  {
   "text": "keyboard repeat speed",
   "lang": "en"
  },
  {
   "text": "изменить скорость повторения клавиш",
   "lang": "ru"
  },
  {
   "text": "настроить задержку клавиш",
   "lang": "ru"
  },
  {
   "text": "kbdrate delay rate",
   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "kbd"
  ]
 },
 "steps": [
  {
   "explain": "Set the typematic delay (in milliseconds) and rate (in Hz). For example, -d 200 sets a 200ms delay, and -r 30 sets a 30Hz repeat rate.",
   "cmd": "sudo kbdrate -d <DELAY_MS> -r <RATE_HZ>",
   "needs_root": true,
   "risk": "low",
   "placeholders": [
    {
     "name": "DELAY_MS",
     "description": "Delay in milliseconds before key repeat starts",
     "example": "200"
    },
    {
     "name": "RATE_HZ",
     "description": "Key repeat rate in Hz",
     "example": "30"
    }
   ]
  }
 ],
 "verify": [
  {
   "cmd": "kbdrate",
   "expect": "Current keyboard rate settings displayed"
  }
 ],
 "rollback": [
  {
   "explain": "Reset to default values (250ms delay, 11Hz rate).",
   "cmd": "sudo kbdrate",
   "needs_root": true,
   "risk": "low"
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Linux_console/Keyboard_configuration#Adjusting_typematic_delay_and_rate",
  "title": "Linux console/Keyboard configuration",
