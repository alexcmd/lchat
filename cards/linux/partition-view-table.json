 "prerequisites": [
  "Identify the block device name (e.g., /dev/sda, /dev/nvme0n1)"
 ],
 "steps": [
  {
   "explain": "Display the partition table of the specified disk. This is a read-only operation.",
   "cmd": "sudo fdisk -l <DEVICE>",
   "needs_root": true,
   "risk": "low",
   "placeholders": [
    {
     "name": "DEVICE",
     "description": "The block device to inspect (e.g., /dev/sda)",
     "example": "/dev/sda",
     "discover_cmd": "lsblk"
    }
   ],
   "expect": "A list of partitions with their start/end sectors, sizes, and types.",
   "alternatives": [
    {
     "explain": "Use parted to print the partition table.",
     "cmd": "sudo parted <DEVICE> print",
     "needs_root": true,
     "risk": "low",
     "placeholders": [
      {
       "name": "DEVICE",
       "description": "The block device to inspect",
       "example": "/dev/sda",
       "discover_cmd": "lsblk"
      }
     ]
    }
   ]
  }
 ],
 "risk": "low",
