{
 "schema_version": 2,
 "id": "arch-find-binary-name",
 "platform": "linux",
 "kind": "task",
 "title": "Find executable name of an installed package",
 "summary": "If you installed a package but don't know the command to run it, you can list the files it installed and filter for binaries in /usr/bin.",
 "aliases": [
  {
   "text": "how to start installed package",
   "lang": "en"
  },
  {
   "text": "find command for package",
   "lang": "en"
  },
  {
   "text": "what is the binary name",
   "lang": "en"
  },
  {
   "text": "как запустить установленный пакет",
   "lang": "ru"
  },
  {
   "text": "найти имя исполняемого файла пакета",
   "lang": "ru"
  },
  {
   "text": "pacman list files package",
   "lang": "en"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "arch"
   }
  ]
 },
 "steps": [
  {
   "explain": "List all files installed by the package and filter for those in /usr/bin/. The output shows the executable names.",
   "cmd": "pacman -Qlq <PACKAGE_NAME> | grep /usr/bin/",
   "risk": "low",
   "placeholders": [
    {
     "name": "PACKAGE_NAME",
     "description": "Name of the installed package",
     "example": "firefox",
     "discover_cmd": "pacman -Qs <SEARCH_TERM>"
    }
   ],
   "expect": "Output shows paths like /usr/bin/firefox. The part after the last slash is the command to run."
  }
 ],
 "risk": "low",
 "source": {
  "url": "https://wiki.archlinux.org/title/Frequently_asked_questions#I_just_installed_Package_X._How_do_I_start_it?",
  "title": "Frequently asked questions",
