   "xdotool"
  ]
 },
 "steps": [
  {
   "explain": "Use xdotool to get the active window ID and pass it to maim to capture just that window.",
   "cmd": "maim --window $(xdotool getactivewindow) <FILE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "FILE",
     "description": "The path where the screenshot will be saved",
     "example": "~/window.png"
    }
   ]
  }
 ],
