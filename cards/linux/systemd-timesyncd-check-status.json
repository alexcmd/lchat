   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ],
  "requires": [
   "systemd",
   "systemd-timesyncd"
  ]
 },
 "steps": [
  {
   "explain": "Show the general status of the system clock and NTP service. Look for 'System clock synchronized: yes' and 'NTP service: active'.",
   "cmd": "timedatectl status",
   "risk": "low",
   "expect": "System clock synchronized: yes\nNTP service: active"
  },
  {
   "explain": "Show verbose details about the NTP synchronization, including the server used, offset, and delay.",
   "cmd": "timedatectl timesync-status",
   "risk": "low",
   "expect": "Server: <IP_ADDRESS> (<SERVER_NAME>)\nPoll interval: ..."
  }
 ],
 "risk": "low",
