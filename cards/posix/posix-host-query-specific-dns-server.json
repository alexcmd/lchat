 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Query the specified DNS server for the domain's records.",
   "cmd": "host <DOMAIN> <DNS_SERVER>",
   "risk": "low",
   "placeholders": [
    {
     "name": "DOMAIN",
     "description": "The domain name to look up",
     "example": "example.com"
    },
    {
     "name": "DNS_SERVER",
     "description": "The IP address of the DNS server to query",
     "example": "8.8.8.8"
    }
   ],
   "alternatives": [
    {
     "explain": "Use drill to query a specific nameserver for a specific record type (e.g., TXT) for a domain.",
     "cmd": "drill <DOMAIN> @<NAMESERVER> <RECORD_TYPE>",
     "placeholders": [
      {
       "name": "DOMAIN",
       "description": "The domain name to query",
       "example": "archlinux.org"
      },
      {
       "name": "NAMESERVER",
       "description": "The IP address of the DNS server to query",
       "example": "8.8.8.8"
      },
      {
       "name": "RECORD_TYPE",
       "description": "The type of DNS record to retrieve (e.g., A, AAAA, TXT, MX)",
       "example": "TXT"
      }
     ],
     "expect": "The command outputs the requested DNS record from the specified server.",
     "risk": "low"
    }
   ]
  }
 ],
 "risk": "low",
