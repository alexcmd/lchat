 "steps": [
  {
   "explain": "Search for directories (-type d) matching the pattern (-iname ignores case).",
   "cmd": "find <DIRECTORY> -type d -iname '<PATTERN>'",
   "risk": "low",
   "placeholders": [
    {
     "name": "DIRECTORY",
     "description": "The folder to search in",
     "example": "."
    },
    {
     "name": "PATTERN",
     "description": "The directory name pattern, e.g. '*lib*'",
     "example": "*lib*"
    }
   ]
  }
 ],
