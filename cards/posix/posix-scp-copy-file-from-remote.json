 ],
 "steps": [
  {
   "explain": "Copy the specified file from the remote host to a local directory.",
   "cmd": "scp <REMOTE_HOST>:<REMOTE_FILE> <LOCAL_DIRECTORY>",
   "risk": "low",
   "placeholders": [
    {
     "name": "REMOTE_HOST",
     "description": "Hostname or IP of the remote computer",
     "example": "user@192.168.1.10"
    },
    {
     "name": "REMOTE_FILE",
     "description": "Path to the file on the remote computer",
     "example": "logs/error.log"
    },
    {
     "name": "LOCAL_DIRECTORY",
     "description": "Destination directory on your computer",
     "example": "~/Downloads"
    }
   ]
  }
 ],
 "risk": "low",
