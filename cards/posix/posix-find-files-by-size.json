 "id": "posix-find-files-by-size",
 "platform": "posix",
 "kind": "task",
 "title": "Find files by size range",
 "summary": "Find files that are larger or smaller than specific sizes, optionally limiting how deep the search goes.",
 "aliases": [
  {
   "text": "find files by size",
   "lang": "en"
  },
  {
