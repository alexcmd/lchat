   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Find files in the directory with a size between the specified limits. Use -maxdepth to limit recursion.",
   "cmd": "find <DIRECTORY> -maxdepth <DEPTH> -size <MIN_SIZE> -size <MAX_SIZE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "DIRECTORY",
     "description": "The folder to search in",
     "example": "."
    },
    {
     "name": "DEPTH",
     "description": "Maximum depth to search (e.g. 1 for current dir only)",
     "example": "1"
    },
    {
     "name": "MIN_SIZE",
     "description": "Minimum size (e.g. +500k for >500KB)",
     "example": "+500k"
    },
    {
     "name": "MAX_SIZE",
     "description": "Maximum size (e.g. -10M for <10MB)",
     "example": "-10M"
    }
   ]
  }
 ],
 "risk": "low",
