 "steps": [
  {
   "explain": "Run lsof with the path to the file to list all processes that have it open.",
   "cmd": "lsof <FILE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "FILE",
     "description": "The full path to the file you want to check",
     "example": "/etc/hosts"
    }
   ],
   "alternatives": [
    {
     "explain": "Run fuser with the path to the file or directory to see the Process IDs (PIDs) of any programs accessing it.",
     "cmd": "fuser <FILE_OR_DIRECTORY>",
     "placeholders": [
      {
       "name": "FILE_OR_DIRECTORY",
       "description": "Path to the file or directory you want to check",
       "example": "/home/user/document.txt"
      }
     ],
     "risk": "low"
    }
   ]
