 ],
 "applies_to": {
  "distros": [
   {
    "family": "any"
   }
  ]
 },
 "steps": [
  {
   "explain": "Recursively compare two directories. This shows which files differ and the specific changes within those files.",
   "cmd": "diff --recursive <OLD_DIR> <NEW_DIR>",
   "risk": "low",
   "placeholders": [
    {
     "name": "OLD_DIR",
     "description": "Path to the first directory",
     "example": "project_v1"
    },
    {
     "name": "NEW_DIR",
     "description": "Path to the second directory",
     "example": "project_v2"
    }
   ],
   "alternatives": [
    {
     "explain": "Show only the names of files that differ, without displaying the content changes.",
     "cmd": "diff --recursive --brief <OLD_DIR> <NEW_DIR>",
     "risk": "low",
     "placeholders": [
      {
       "name": "OLD_DIR",
       "description": "Path to the first directory",
       "example": "project_v1"
      },
      {
       "name": "NEW_DIR",
       "description": "Path to the second directory",
       "example": "project_v2"
      }
     ]
    }
   ]
  }
 ],
 "risk": "low",
