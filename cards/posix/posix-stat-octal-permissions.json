 "steps": [
  {
   "explain": "Use the --format option with the %a (octal permissions) and %n (filename) specifiers to print only the permission code.",
   "cmd": "stat -c \"%a %n\" <FILE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "FILE",
     "description": "Path to the file",
     "example": "script.sh"
    }
   ],
   "expect": "Output showing the octal permission code (e.g., 644) followed by the filename."
  }
 ],
