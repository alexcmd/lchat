 "steps": [
  {
   "explain": "Extract the archive preserving the original directory structure into the current directory.",
   "cmd": "7z x <ARCHIVE_PATH>",
   "risk": "low",
   "placeholders": [
    {
     "name": "ARCHIVE_PATH",
     "description": "Path to the archive file",
     "example": "backup.7z"
    }
   ],
   "alternatives": [
    {
     "explain": "Extract the archive to a specific output directory.",
     "cmd": "7z x <ARCHIVE_PATH> -o<OUTPUT_DIR>",
     "placeholders": [
      {
       "name": "ARCHIVE_PATH",
       "description": "Path to the archive file",
       "example": "backup.7z"
      },
      {
       "name": "OUTPUT_DIR",
       "description": "Path to the directory where files will be extracted",
       "example": "extracted_folder"
      }
     ]
    }
   ]
  }
 ],
 "risk": "low",
