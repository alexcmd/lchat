 "steps": [
  {
   "explain": "Copy the source directory and all its contents to the target directory. If the target exists, the source directory is copied inside it.",
   "cmd": "cp -r <SOURCE_DIRECTORY> <TARGET_DIRECTORY>",
   "risk": "low",
   "placeholders": [
    {
     "name": "SOURCE_DIRECTORY",
     "description": "Path to the directory you want to copy",
     "example": "my_project"
    },
    {
     "name": "TARGET_DIRECTORY",
     "description": "Path to the destination directory",
     "example": "backups/my_project"
    }
   ],
   "alternatives": [
    {
     "explain": "Use the short flag for recursive copy.",
     "cmd": "cp -r <SOURCE_DIRECTORY> <TARGET_DIRECTORY>",
     "risk": "low",
     "placeholders": [
      {
       "name": "SOURCE_DIRECTORY",
       "description": "Path to the directory you want to copy",
       "example": "my_project"
      },
      {
       "name": "TARGET_DIRECTORY",
       "description": "Path to the destination directory",
       "example": "backups/my_project"
      }
     ]
    }
   ]
  }
 ],
 "risk": "low",
