 "steps": [
  {
   "explain": "Run printenv followed by the name of the variable you want to check.",
   "cmd": "printenv <VARIABLE_NAME>",
   "risk": "low",
   "placeholders": [
    {
     "name": "VARIABLE_NAME",
     "description": "The name of the environment variable to display (e.g., HOME, PATH, USER).",
     "example": "HOME"
    }
   ],
   "alternatives": [
    {
     "explain": "Use the echo command with a variable name prefixed by a dollar sign ($). The shell will replace the variable name with its value before printing.",
     "cmd": "echo \"<VARIABLE_NAME>\"",
     "placeholders": [
      {
       "name": "VARIABLE_NAME",
       "description": "The environment variable to print, e.g. $PATH or $HOME",
       "example": "$PATH"
      }
