 "id": "posix-awk-filter-lines",
 "platform": "posix",
 "kind": "task",
 "title": "Filter lines by column value or pattern",
 "summary": "Use awk to print only lines that match a specific condition, such as a column value within a range or a specific pattern.",
 "aliases": [
  {
   "text": "filter lines by value",
   "lang": "en"
  },
