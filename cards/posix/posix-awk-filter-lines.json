 "steps": [
  {
   "explain": "Print lines where the 10th column value is between a minimum and maximum. Change $10 to the column number and adjust the min/max values.",
   "cmd": "awk '($10 >= <MIN> && $10 <= <MAX>)' <FILE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "MIN",
     "description": "Minimum value for the column",
     "example": "10"
    },
    {
     "name": "MAX",
     "description": "Maximum value for the column",
     "example": "100"
    },
    {
     "name": "FILE",
     "description": "Path to the text file",
     "example": "data.txt"
    }
   ],
   "alternatives": [
    {
     "explain": "Print every third line starting from the first line.",
     "cmd": "awk 'NR%3==1' <FILE>",
     "risk": "low",
     "placeholders": [
      {
       "name": "FILE",
       "description": "Path to the text file",
       "example": "data.txt"
      }
     ]
    }
   ]
  }
 ],
 "risk": "low",
