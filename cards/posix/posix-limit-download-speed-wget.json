 "steps": [
  {
   "explain": "Set a maximum download speed (e.g., 300k for 300 KB/s) and the number of retries for failed connections.",
   "cmd": "wget --limit-rate <RATE> --tries <RETRIES> <URL>",
   "risk": "low",
   "placeholders": [
    {
     "name": "RATE",
     "description": "Maximum download speed, e.g. 300k, 1m",
     "example": "300k"
    },
    {
     "name": "RETRIES",
     "description": "Number of connection retries",
     "example": "100"
    },
    {
     "name": "URL",
     "description": "The URL to download",
     "example": "https://example.com/foo"
    }
   ]
  }
 ],
 "risk": "low",
