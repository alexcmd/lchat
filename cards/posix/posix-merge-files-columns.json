 "steps": [
  {
   "explain": "Use `paste` with two file arguments to merge them line-by-line into columns, separated by tabs.",
   "cmd": "paste <FILE1> <FILE2>",
   "risk": "low",
   "placeholders": [
    {
     "name": "FILE1",
     "description": "Path to the first file",
     "example": "names.txt"
    },
    {
     "name": "FILE2",
     "description": "Path to the second file",
     "example": "scores.txt"
    }
   ],
   "alternatives": [
    {
     "explain": "Use a custom delimiter (like a comma) instead of a tab to separate the columns.",
     "cmd": "paste -d <DELIMITER> <FILE1> <FILE2>",
     "placeholders": [
      {
       "name": "DELIMITER",
       "description": "The character to use between columns",
       "example": ","
      },
      {
       "name": "FILE1",
       "description": "Path to the first file",
       "example": "names.txt"
      },
      {
       "name": "FILE2",
       "description": "Path to the second file",
       "example": "scores.txt"
      }
     ]
    }
   ]
  }
 ],
