   "explain": "Sort the file to group identical lines, then use `uniq` with the `--count` flag to display each unique line preceded by its occurrence count.",
   "cmd": "sort <FILE> | uniq --count",
   "risk": "low",
   "placeholders": [
    {
     "name": "FILE",
     "description": "Path to the text file",
     "example": "data.txt"
    }
   ]
  }
 ],
