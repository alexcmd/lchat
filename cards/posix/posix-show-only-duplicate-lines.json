 "steps": [
  {
   "explain": "Sort the file to group identical lines, then use `uniq` with the `--repeated` flag to display only lines that occur multiple times.",
   "cmd": "sort <FILE> | uniq --repeated",
   "risk": "low",
   "placeholders": [
    {
     "name": "FILE",
     "description": "Path to the text file",
     "example": "data.txt"
    }
   ]
  }
 ],
