 ],
 "applies_to": {
  "distros": [
   {
    "family": "macos"
   }
  ]
 },
 "prerequisites": [
  "dockutil is installed (usually via Homebrew)"
 ],
 "steps": [
  {
   "explain": "Removes the item with the specified label from the current user's Dock.",
   "cmd": "dockutil --remove '<DOCK_ITEM_LABEL>'",
   "risk": "low",
   "placeholders": [
    {
     "name": "DOCK_ITEM_LABEL",
     "description": "The label name of the item in the Dock, e.g. 'Safari' or 'Trash'",
     "example": "Safari"
    }
   ]
  }
 ],
