 "steps": [
  {
   "explain": "Stops and then starts the Apache HTTP server launchd job.",
   "cmd": "sudo apachectl restart",
   "risk": "medium",
   "needs_root": true
  }
 ],
 "risk": "medium",
 "rollback": [
