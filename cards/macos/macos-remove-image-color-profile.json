 "steps": [
  {
   "explain": "Run `sips` with `--deleteProperty profile` and `--deleteColorManagementProperties` on the target image. This modifies the file in place.",
   "cmd": "sips --deleteProperty profile --deleteColorManagementProperties <IMAGE_FILE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "IMAGE_FILE",
     "description": "Path to the image file",
     "example": "photo.jpg"
    }
   ]
  }
 ],
