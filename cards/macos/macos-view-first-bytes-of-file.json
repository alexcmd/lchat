   "lang": "ru"
  }
 ],
 "applies_to": {
  "distros": [
   {
    "family": "macos"
   }
  ]
 },
 "steps": [
  {
   "explain": "Use the `-c` (or `--bytes`) flag followed by the number of bytes to display, then the file path.",
   "cmd": "head -c <NUMBER> <FILE>",
   "risk": "low",
   "placeholders": [
    {
     "name": "NUMBER",
     "description": "The number of bytes to display.",
     "example": "100"
    },
    {
     "name": "FILE",
     "description": "The path to the file.",
     "example": "~/Downloads/image.png"
    }
   ],
   "alternatives": [
    {
     "explain": "You can also use the long form `--bytes` instead of `-c`.",
     "cmd": "head --bytes <NUMBER> <FILE>",
     "risk": "low",
     "placeholders": [
      {
       "name": "NUMBER",
       "description": "The number of bytes to display.",
       "example": "100"
      },
      {
       "name": "FILE",
       "description": "The path to the file.",
       "example": "~/Downloads/image.png"
      }
     ]
    }
   ]
  }
 ],
 "risk": "low",
