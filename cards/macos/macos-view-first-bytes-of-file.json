 "kind": "task",
 "title": "View the first bytes of a file",
 "summary": "Use the `head` command with the `-c` flag to display a specific number of bytes from the start of a file, which is useful for binary files or checking file headers.",
 "aliases": [
  {
   "text": "head bytes mac",
   "lang": "en"
