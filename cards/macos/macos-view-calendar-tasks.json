   "explain": "List all uncompleted tasks from your calendar.",
   "cmd": "icalBuddy uncompletedTasks",
   "risk": "low",
   "alternatives": [
    {
     "explain": "Show tasks due within a specific number of days from today.",
     "cmd": "icalBuddy --includeOnlyEventsFromNowOn \"tasksDueBefore:today+<NUMBER_OF_DAYS>\"",
     "risk": "low",
     "placeholders": [
      {
       "name": "NUMBER_OF_DAYS",
       "description": "Number of days to look ahead for tasks",
       "example": "7"
      }
     ]
    }
   ]
  }
 ],
