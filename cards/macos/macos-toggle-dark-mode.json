 ],
 "applies_to": {
  "distros": [
   {
    "family": "macos"
   }
  ]
 },
 "steps": [
  {
   "explain": "Run the command to toggle the current appearance. If Dark Mode is off, it turns on; if on, it turns off.",
   "cmd": "dark-mode",
   "risk": "low",
   "gui": "System Settings > Appearance > Click 'Auto', 'Light', or 'Dark'",
   "alternatives": [
    {
     "explain": "Explicitly turn Dark Mode on.",
     "cmd": "dark-mode on",
     "risk": "low"
    },
    {
     "explain": "Explicitly turn Dark Mode off (Light Mode).",
     "cmd": "dark-mode off",
     "risk": "low"
    }
   ]
  }
 ],
 "verify": [
  {
   "cmd": "dark-mode status",
   "expect": "Displays whether Dark Mode is currently on or off."
  }
 ],
 "risk": "low",
